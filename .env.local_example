MACHINE_NAME=CHANGE_ME

# Prod URL overrides (tracked .env defaults to localhost)
APP_URL=https://convertor.xakki.pro
API_URL=https://convertor.xakki.pro

GRAYLOG_HOST=CHANGE_ME

MARIADB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME
EXPORTER_PASS=CHANGE_ME

# WS-Gateway internal-relay bearer (gateway→Symfony persist); empty in tracked .env
GATEWAY_INTERNAL_TOKEN=CHANGE_ME

# Bearer token workers use for WS-upgrade + direct HTTP to Symfony; empty in tracked .env
WORKER_API_TOKEN=CHANGE_ME

S3_SECRET=CHANGE_ME
#S3_KEY=convertor-dev
#S3_BUCKET_PREFIX=convertor
#S3_DUMP_BUCKET=convertor-dump

# ============================================================================
# Remote worker host (WS-клиент-only: 5 non-AI воркеров + worker-ai:cpu, БЕЗ
# php/mariadb/nginx/keydb/ws-gateway/metrics-exporter — те остаются на главном
# сервере). Заполнять ТОЛЬКО этот блок в .env.local remote-хоста — секции выше
# (MARIADB_*, GATEWAY_INTERNAL_TOKEN, S3_*, ...) там не нужны и не используются
# таргетами build-workers-remote / remote-workers-{up,recreate,down,logs}.
# Пошаговый деплой — docs/workers-remote-deploy.md.
# ============================================================================

# ОБЯЗАТЕЛЬНО отличается от главного сервера (там xakki-convertor) — иначе
# WORKER_ID (= hostname контейнера, производный от COMPOSE_PROJECT_NAME)
# совпадёт с on-server воркерами и consumer'ы столкнутся в KeyDB XREADGROUP.
COMPOSE_PROJECT_NAME=convertor-remote-CHANGE_ME

# Bearer для WS-upgrade + прямого HTTP к API. Секрет, дефолта нет и быть не
# может — пустое значение = воркер отказывается стартовать (без reconnect-storm).
WORKER_API_TOKEN=CHANGE_ME

# Публичный WS-эндпоинт gateway на главном сервере + корень API (БЕЗ /api).
GATEWAY_WS_URL=wss://convertor.xakki.pro/ws/worker/
API_BASE_URL=https://convertor.xakki.pro

# Локально собранный CPU-образ AI-воркера (make build-ai-cpu / build-workers-remote
# уже собирает его). Harbor-тег из трекаемого .env сюда НЕ подходит — тот образ не
# публикуется (см. docs/worker-ai-deploy.md, двухслойная схема).
DOCKER_IMAGE_AI=xakki-convertor/worker-ai:cpu

# Graylog GELF-эндпоинт — тот же публичный адрес, что и на главном сервере (общий
# путь логов: fluent-bit → https://log.variantgood.com/gelf, TLS 443).
GRAYLOG_HOST=log.variantgood.com
GRAYLOG_PORT=443
GRAYLOG_URI=/gelf

# Идентифицируют remote-хост в записях Graylog (лейблы fluent-bit-сайдкара). Без
# оверрайда Makefile сам вычисляет их через `hostname`/`hostname -I` — переопределять
# имеет смысл, только если авто-значение неинформативно (напр. generic-имя VM).
HOST_NAME=CHANGE_ME
HOST_IP=CHANGE_ME

# ВНИМАНИЕ: EXT_FLUENT_PORT — ОБЯЗАТЕЛЬНО пустой, именно явно (просто не упомянуть
# переменную здесь НЕДОСТАТОЧНО: она уже задана в трекаемом .env = 127.0.0.1:10094,
# и -include .env.local поверх .env её не "развключит" сам по себе — нужно явно
# перезаписать пустым значением, как ниже). Причина: 127.0.0.1:10094 в трекаемом
# .env — порт per-project fluent-bit-сайдкара НА ГЛАВНОМ СЕРВЕРЕ, подобранный так,
# чтобы не конфликтовать с уже занятым там отдельным хостовым 127.0.0.1:24224.
# worker-ai при этом логирует в СВОЙ инлайновый адрес 127.0.0.1:24224
# (docker-compose.worker-ai.yml, захардкожен, НЕ через ${EXT_FLUENT_PORT}) — если бы
# сайдкар remote-хоста унаследовал 10094 из трекаемого .env, логи worker-ai туда бы
# не попадали (пятеро non-AI воркеров и worker-ai писали бы в РАЗНЫЕ адреса). Пустая
# строка ниже триггерит "${EXT_FLUENT_PORT:-127.0.0.1:24224}" (порт самого сайдкара)
# И заставляет docker fluentd-driver 5 non-AI воркеров (${EXT_FLUENT_PORT} без
# дефолта в docker/fluent-logging.yml) откатиться на встроенный дефолт драйвера
# localhost:24224 — совпадает с хардкодом worker-ai. Проверено эмпирически:
# `docker run --log-opt fluentd-address=` не падает и ведёт себя как omitted-опция.
EXT_FLUENT_PORT=
