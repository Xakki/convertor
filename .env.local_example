MACHINE_NAME=CHANGE_ME

MARIADB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME
EXPORTER_PASS=CHANGE_ME

# WS-Gateway internal-relay bearer (gateway→Symfony persist); empty in tracked .env
GATEWAY_INTERNAL_TOKEN=CHANGE_ME

# Bearer token workers use for WS-upgrade + direct HTTP to Symfony; empty in tracked .env
WORKER_API_TOKEN=CHANGE_ME

S3_SECRET=CHANGE_ME
#S3_KEY=convertor-dev
#S3_BUCKET_PREFIX=convertor
#S3_DUMP_BUCKET=convertor-dump

# ============================================================================
# Remote worker host (WS-клиент-only: все 6 воркеров — 5 non-AI + worker-ai —
# БЕЗ php/mariadb/nginx/keydb/ws-gateway/metrics-exporter — те остаются на
# главном сервере). Заполнять ТОЛЬКО этот блок в .env.local remote-хоста —
# секции выше (MARIADB_*, GATEWAY_INTERNAL_TOKEN, S3_*, ...) там не нужны и не
# используются. Пошаговый деплой — docs/workers-remote-deploy.md.
#
# GRAYLOG_*/HOST_NAME/HOST_IP/EXT_FLUENT_PORT конфигурировать НЕ нужно: с 2026-07
# worker-ai — обычный сервис в docker-compose.yml на общем shared x-logging
# (docker/fluent-logging.yml), как и остальные 5 воркеров, — все 6 шлют логи
# через один и тот же ${EXT_FLUENT_PORT} (трекаемый .env уже даёт верный дефолт
# на любом хосте), а HOST_NAME/HOST_IP Makefile сам вычисляет через
# `hostname`/`hostname -I`. Переопределять любую из них имеет смысл, только
# если авто-значение неинформативно (напр. generic-имя VM) — тогда просто
# добавьте нужную переменную сюда явно.
# ============================================================================

# ОБЯЗАТЕЛЬНО отличается от главного сервера (там xakki-convertor) — иначе
# WORKER_ID (= hostname контейнера, производный от COMPOSE_PROJECT_NAME)
# совпадёт с on-server воркерами и consumer'ы столкнутся в KeyDB XREADGROUP.
COMPOSE_PROJECT_NAME=convertor-remote-CHANGE_ME

# Bearer для WS-upgrade + прямого HTTP к API. Секрет, дефолта нет и быть не
# может — пустое значение = воркер отказывается стартовать (без reconnect-storm).
# Пусто здесь НАРОЧНО — это трекаемый шаблон, реальный токен только в .env.local.
WORKER_API_TOKEN=

# GPU-хост (опционально): раскомментировать обе строки, чтобы worker-ai
# собирался/запускался на CUDA-образе через nvidia-runtime вместо CPU по
# умолчанию (см. worker-ai в docker-compose.yml, docs/workers-remote-deploy.md).
