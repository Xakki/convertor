# ─────────────────────────────────────────────────────────────────────────────
# Template for the local .env (which is gitignored). Copy to .env and adjust.
# Documents EVERY variable consumed by docker-compose.yml + docker/fluent-logging.yml.
# ─────────────────────────────────────────────────────────────────────────────

# Compose / project
COMPOSE_PROJECT_NAME=xakki-convertor
# re-add `:docker/fluent-logging.yml` once the Xakki/FluentLog submodule is fetched — see fluent-logging-setup card
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=dev
DOCKER_ENV=dev                # selects docker/{php,nginx,mariadb}/<env>/ config dirs
APP_ENV=dev
APP_URL=http://localhost
API_URL=http://localhost
MACHINE_NAME=convertor-dev    # node/host identifier (must not stay "change_me")
XDEBUG_MODE=off
TZ=UTC
# Host uid/gid — php/cron entrypoint remaps www-data to these so composer deploy
# can write the bind-mounted /app-symfony. Set to your host `id -u`/`id -g`.
PUID=1000
PGID=1000

# Graylog / fluent logging
GRAYLOG_HOST=log.localhost
GRAYLOG_URI=/gelf
GRAYLOG_PORT=443

# Container images (php/mariadb/nginx/keydb/libreoffice pulled from harbor)
DOCKER_IMAGE_PHP=harbor.xakki.ru/library/php:8.5-fpm-dev
DOCKER_IMAGE_MARIADB=harbor.xakki.ru/external/mariadb:12
DOCKER_IMAGE_NGINX=harbor.xakki.ru/external/nginx
DOCKER_IMAGE_KEYDB=harbor.xakki.ru/external/keydb
DOCKER_IMAGE_LIBRE=harbor.xakki.ru/library/libreoffice
DOCKER_IMAGE_NODE=node:22-alpine

# Host-side published ports (bind addr:port). Keep on 127.0.0.1 except the
# shared-reverse-proxy nginx which uses the docker0 bridge 172.17.0.1.
EXT_NGINX_PORT=172.17.0.1:10090
EXT_NGINX_PORTS=127.0.0.1:10091
EXT_MYSQL_PORT=127.0.0.1:10092
EXT_REDIS_PORT=127.0.0.1:10093
EXT_FLUENT_PORT=127.0.0.1:10094
EXT_FLUENT_METRIC_PORT=127.0.0.1:10095
EXT_NODE_PORT=127.0.0.1:10096
EXT_LIBRE_PORT=127.0.0.1:10097

COMPOSER_NO_DEV=0

# MariaDB provisioning (root + app user/db created by the mariadb image)
MARIADB_DATABASE=convertor
MARIADB_USER=convertor
MARIADB_PASSWORD=123456
MARIADB_ROOT_PASSWORD=123456
EXPORTER_USER=exportuser
EXPORTER_PASS=123456
MARIADB_PASSWORD_WALL=        # optional extra user; empty if unused

# App DB connection injected into php/cron. Must match MARIADB_* above.
# NOTE: the Symfony app actually connects via DATABASE_URL in app-symfony/.env —
# keep both in sync.
DB_HOST=mariadb
DB_USERNAME=convertor
DB_DATABASE=convertor
DB_PASSWORD=123456

# KeyDB auth — MUST stay empty: keydb.conf has no requirepass (protected-mode no);
# a non-empty value makes the workers' redis AUTH fail against a no-auth server.
REDIS_PASSWORD=

# Telegram login. Supply a real token before enabling login; empty = feature off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=YouFileConvertBot

# Whisper STT model size (tiny / base / small / medium / large)
WHISPER_MODEL=base

# Payments are FROZEN (free-with-limits). Leave empty — not required to boot.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

# S3 / MinIO storage (prod object storage; dev uses local /shared-files)
S3_ENDPOINT=http://s3.localhost
S3_URL=http://localhost
S3_REGION=us-east-1
S3_KEY=convertor-dev
S3_SECRET=
S3_BUCKET_PREFIX=convertor-dev
S3_DUMP_BUCKET=convertor-dump
S3_USE_PATH_STYLE=true
