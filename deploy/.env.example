## Публичный remote-worker bootstrap (.env).
## Скопировать в `.env` рядом с docker-compose.yml или дать install.sh сделать это.
## Секреты в gist/репо НЕ кладём — только плейсхолдеры.

# Обязательный bearer для WS-upgrade + HTTP к API (тот же, что на главном сервере).
# Пустое значение = воркеры откажутся стартовать.
WORKER_API_TOKEN=

# Уникальное имя compose-проекта на ЭТОМ хосте (только lowercase, цифры, дефис).
# WORKER_ID = ${COMPOSE_PROJECT_NAME}-worker-* — не должно совпадать с другими хостами.
# Оператор ОБЯЗАН заменить changeme на свой уникальный суффикс перед продом.
COMPOSE_PROJECT_NAME=convertor-remote-changeme

# Профили, выбранные install.sh (через пробел). Пример: document image data
# Используется режимом update; при ручном запуске передавайте --profile сами.
WORKER_PROFILES=document audio video image data

# Canonical host identity for telemetry (lowercase DNS-label/FQDN, mandatory).
HOST_NAME=

GATEWAY_INTERNAL_TOKEN=

# Публичные эндпоинты главного сервера (override только для нестандартного стенда).
GATEWAY_WS_URL=wss://convertor.xakki.pro/ws/worker/
API_BASE_URL=https://convertor.xakki.pro

# Образы Harbor (anonymous pull).
IMAGE_NS=harbor.xakki.ru/convertor
IMAGE_TAG=latest

# Публичный путь всегда тянет свежие теги (нет локального build:-фолбэка).
WORKER_PULL_POLICY=always
AI_PULL_POLICY=always

# Только CPU. CUDA в публичный deploy не входит.
AI_VARIANT=cpu

APP_ENV=prod
TZ=UTC
