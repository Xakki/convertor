## Шаблон .env.local для REMOTE worker-хоста (напр. uBook).
##
## Копировать как `.env.local` на том хосте. Здесь только ДИФФ к трекаемому .env;
## всё остальное (образы, порты gateway, тюнинг WS/reclaim, Whisper) наследуется.
##
## Смысл: на этом хосте `make up` поднимает ТОЛЬКО воркеров + fluent-bit-сайдкар.
## php / cron / mariadb / keydb / nginx / ws-gateway / metrics-exporter остаются
## на главном сервере — сюда они не приезжают, потому что их профиль `server`
## (и `monitoring`) здесь НЕ активирован. Обычные `make up` / `make down` /
## `make build-workers` / `make workers-recreate` работают как есть.
##
## S3-креды воркерам НЕ нужны: они ходят только к gateway (WS) и к Symfony API
## (HTTP). MARIADB_*, GATEWAY_INTERNAL_TOKEN, S3_SECRET здесь не заполняем.
## Пошаговый деплой — docs/workers-remote-deploy.md.

# ОБЯЗАТЕЛЬНО отличается от главного сервера (там xakki-convertor) — иначе
# WORKER_ID (= hostname контейнера, производный от COMPOSE_PROJECT_NAME)
# совпадёт с on-server воркерами и consumer'ы столкнутся в KeyDB XREADGROUP.
COMPOSE_PROJECT_NAME=convertor-remote-CHANGE_ME

# Профили: только `ai` (worker-ai). Остальные воркеры профиля не имеют и
# поднимаются всегда. НЕ добавлять `server`/`monitoring` — иначе `make up`
# потянет php/mariadb/nginx/ws-gateway/metrics-exporter, которых здесь нет
# (metrics-exporter к тому же требует внешнюю сеть `common` с главного сервера).
# CPU-хост без worker-ai — оставить пустым: COMPOSE_PROFILES=
COMPOSE_PROFILES=ai

# Пулл вместо сборки: воркеры тянут готовый образ из Harbor (harbor-published-worker-images),
# а не собирают его на этом хосте (~7-8 мин на холодную). IMAGE_TAG можно запиннить
# версией релиза (напр. 0.1-a1b2c3d) вместо подвижного latest.
# missing, а не always: `always` при недоступном/отсутствующем в Harbor теге
# (фолбэк на свежем хосте до первого релиза) хардфейлит `make up` вместо
# сборки из build:-секции. Обновления образов приходят явным `make pull`
# (уже в remote happy-path: git pull && make pull && make workers-recreate) —
# always тут ничего не даёт, а фолбэк ломает.
WORKER_PULL_POLICY=missing
IMAGE_TAG=latest
# CPU-хост (дефолт): пуллим готовый worker-ai:latest-cpu из Harbor, не собираем
# 3 GB ML-образ локально. ВАЖНО: только GPU-хост (AI_VARIANT=cuda ниже) должен
# переопределить AI_PULL_POLICY=build — worker-ai:latest-cuda в Harbor НЕ
# публикуется (§1) и обязан собираться локально из worker-ai-base.
AI_PULL_POLICY=always

# Осознанное отклонение от saFin: там host-level shared-fluent-bit; на remote —
# project sidecar из сабмодуля docker/fluent-log (добавляем его в COMPOSE_FILE).
# Сабмодуль обязателен: git submodule update --init docker/fluent-log
COMPOSE_FILE=docker-compose.yml:docker/fluent-log/docker-fluent.yml:docker/fluent-logging.yml:docker/limits.yml

# Intake сайдкара — только loopback: docker logging-driver на хосте → sidecar.
# НЕ биндить 0.0.0.0 — сборщик не должен слушать снаружи.
EXT_FLUENT_PORT=127.0.0.1:24224
EXT_FLUENT_METRIC_PORT=127.0.0.1:10095

# Bearer для WS-upgrade + прямого HTTP к API. Секрет, дефолта нет и быть не
# может — пустое значение = воркер отказывается стартовать (без reconnect-storm).
# Значение ТО ЖЕ, что на главном сервере (иначе gateway рвёт WS close 1008).
WORKER_API_TOKEN=CHANGE_ME

# GPU-хост (опционально): worker-ai на CUDA-образе через nvidia-runtime вместо
# CPU по умолчанию. Собирать образ через `make build-ai-cuda`. AI_PULL_POLICY
# ОБЯЗАТЕЛЬНО переключить на build — worker-ai:latest-cuda в Harbor не
# публикуется, `always` здесь хардфейлит на "pull access denied", а `missing`
# чинит только `make up` (build-фолбэк); явный `make pull` при `missing` всё
# равно пытается запросить несуществующий тег и падает с exit 2 — `build`
# заставляет `docker compose pull` пропустить сервис (Skipped), проверено
# эмпирически.
# AI_VARIANT=cuda
# AI_RUNTIME=nvidia
# AI_PULL_POLICY=build

# HOST_NAME / HOST_IP Makefile вычисляет сам (`hostname` / `hostname -I`).
# Переопределять только если авто-значение неинформативно (generic-имя VM).
# HOST_NAME=my-worker-host
