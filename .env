## Базовая конфигурация стенда (трекается, секретов НЕТ — только плейсхолдеры).
##
## Поведение ВСЕХ make-таргетов и compose определяется только этими файлами:
##   .env  →  .env.local (секреты хоста, gitignored)  →  .env.test (только под
##   `make test*`, TEST=1; перетирает и .env.local)
## Makefile инклудит их в этом порядке и экспортирует — compose видит результат.
##
## Переменные, которые нужны ТОЛЬКО бэкенду (Symfony читает их сам через Dotenv),
## живут в app-symfony/.env* и здесь НЕ дублируются.

# ── Идентичность стенда
COMPOSE_PROJECT_NAME=xakki-convertor
COMPOSE_FILE=docker-compose.yml:docker/fluent-logging.yml:docker/limits.yml
# Профили compose = что именно поднимает `make up` на этом хосте:
#   server     — php/cron/mariadb/keydb/nginx/ws-gateway (серверная часть)
#   monitoring — metrics-exporter (жёсткое имя контейнера, скрейпится Prometheus'ом)
#   ai         — worker-ai (тяжёлый образ)
# Остальные воркеры профиля не имеют — поднимаются всегда. Главный сервер = всё;
# тест-стенд и remote worker-хост берут свои наборы (.env.test / .env.local).
COMPOSE_PROFILES=server,monitoring,ai
# Namespace образов воркеров. НЕ переопределять в .env.test: образы общие для
# dev- и тест-стенда, иначе тест-стенд начнёт пересобирать их под своим именем.
# По умолчанию — Harbor (публикуемые runnable-образы, harbor-published-worker-images).
IMAGE_NS=harbor.xakki.ru/convertor
# Подвижный тег релиза; remote-хост может запиннить версию через IMAGE_TAG в
# своём .env.local (напр. 0.1-a1b2c3d).
IMAGE_TAG=latest
DOCKER_ENV=dev
APP_ENV=dev
APP_VER=0.1
TZ=UTC
# Публичный URL для `make tg-set-webhook`. Symfony берёт свой APP_URL из app-symfony/.env.
API_URL=https://convertor.xakki.pro
# php/cron entrypoint ремапит www-data в этот uid/gid — иначе composer deploy
# не запишет bind-mounted /app-symfony.
PUID=1000
PGID=1000

# ── Образы
DOCKER_IMAGE_PHP=harbor.xakki.ru/library/php:8.5-fpm-dev
DOCKER_IMAGE_MARIADB=harbor.xakki.ru/external/mariadb:12
DOCKER_IMAGE_NGINX=harbor.xakki.ru/external/nginx
DOCKER_IMAGE_KEYDB=harbor.xakki.ru/external/keydb

# ── Публикуемые хост-порты (bind addr:port)
EXT_NGINX_PORT=172.17.0.1:10090
EXT_NGINX_PORTS=127.0.0.1:10091
EXT_MYSQL_PORT=127.0.0.1:10092
EXT_REDIS_PORT=127.0.0.1:10093
# Лог-сток для docker logging-driver: общий host-wide fluent-bit (свой сайдкар на
# главном сервере НЕ поднимаем — порт занят общим; сайдкар нужен только remote-хостам).
EXT_FLUENT_PORT=127.0.0.1:24224
# Публикуемый порт метрик СВОЕГО сайдкара (актуально только на remote-хосте).
EXT_FLUENT_METRIC_PORT=127.0.0.1:10095

# ── Логи — ВНЕШНИЙ Graylog (локальный инстанс не поднимаем)
GRAYLOG_HOST=log.variantgood.com
GRAYLOG_URI=/gelf
GRAYLOG_PORT=443

# ── MariaDB
# app-symfony/.env — при смене значений здесь синхронизировать и его.
MARIADB_DATABASE=convertor
MARIADB_USER=convertor
MARIADB_PASSWORD=123456
MARIADB_ROOT_PASSWORD=123456
EXPORTER_USER=exportuser
EXPORTER_PASS=123456

# ── KeyDB
# keydb.conf идёт БЕЗ requirepass (protected-mode no) → пароль ДОЛЖЕН быть пуст,
# иначе AUTH воркеров падает.
REDIS_PASSWORD=
# Индекс БД ОЧЕРЕДЕЙ. Читают ws-gateway и metrics-exporter (внутри контейнера
# переменная зовётся REDIS_DB). Индексы кеша (0) и сессий (1) задаются отдельными
# DSN'ами в app-symfony/.env — здесь их нет.
REDIS_QUEUE_DB=2

# ── WS-Gateway (не секреты, кроме токенов)
WS_HOST=0.0.0.0
WS_PORT=8091
# Таймаут XREADGROUP ... BLOCK <ms>.
WS_BLOCK_MS=5000
# Порог inline-результата, байты декодированного payload'а.
WS_RESULT_INLINE_MAX=262144
# internal-relay gateway→Symfony (persist результата).
SYMFONY_INTERNAL_URL=http://nginx
GATEWAY_INTERNAL_TOKEN=
# Liveness ping/pong: потребляет КЛИЕНТ-воркер, сервер только отвечает pong.
# Окно reconnect (interval*missed) держим ≪ idle-порога reclaim ниже.
WS_PING_INTERVAL_S=20
WS_LIVENESS_MISSED_PINGS=3
WS_RECONNECT_BACKOFF_BASE_S=1
WS_RECONNECT_BACKOFF_MAX_S=30
WS_RECONNECT_BACKOFF_FACTOR=2
# Reclaim — ТОЛЬКО по per-type idle-порогу (по WS-дисконнекту запрещён).
RECLAIM_INTERVAL_S=60
RECLAIM_BATCH=10
RECLAIM_IDLE_MS_DOCUMENT=300000
RECLAIM_IDLE_MS_IMAGE=120000
RECLAIM_IDLE_MS_AUDIO=300000
RECLAIM_IDLE_MS_VIDEO=600000
RECLAIM_IDLE_MS_DATA=180000
RECLAIM_IDLE_MS_AI=300000

# ── Воркеры (WS-клиенты)
# Bearer для WS-upgrade и прямого HTTP к API. Секрет → .env.local; пусто = воркер
# не стартует. Единый источник для php/gateway/воркеров — этот файл (+ .env.local).
WORKER_API_TOKEN=
GATEWAY_WS_URL=wss://convertor.xakki.pro/ws/worker/
API_BASE_URL=https://convertor.xakki.pro

# ── AI-воркер
DEVSERVER_ALLOWED_ORIGINS=https://convertor.xakki.pro
DEVSERVER_HOST=0.0.0.0
# Whisper STT: размер модели (tiny/base/small/medium/large), устройство и compute type.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── S3 / MinIO
# Бакеты: ${S3_BUCKET_PREFIX}-inputs (загрузки) + -results (результаты).
S3_ENDPOINT=https://apis3.xakki.ru
S3_REGION=us-east-1
S3_KEY=convertor-dev
S3_SECRET=
S3_BUCKET_PREFIX=convertor-dev
S3_DUMP_BUCKET=convertor-dump
S3_USE_PATH_STYLE=true

# ── Платежи — ЗАМОРОЖЕНЫ (MVP = только Telegram). Пусто, для загрузки не нужны.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
