COMPOSE_PROJECT_NAME=xakki-convertor
COMPOSE_FILE=docker-compose.yml:docker/fluent-logging.yml:docker/limits.yml
COMPOSE_PROFILES=dev
DOCKER_ENV=dev
APP_ENV=dev
APP_VER=0.1
APP_URL=https://convertor.xakki.pro
API_URL=https://convertor.xakki.pro
MACHINE_NAME=convertor-dev
XDEBUG_MODE=off
TZ=UTC
# Host uid/gid — php/cron entrypoint remaps www-data to these so composer deploy
# can write the bind-mounted /app-symfony. Host-specific dev defaults (this host).
PUID=1000
PGID=1000

# Centralized logging target = REMOTE Graylog (do NOT stand up a local instance).
GRAYLOG_HOST=log.variantgood.com
GRAYLOG_URI=/gelf
GRAYLOG_PORT=443

DOCKER_IMAGE_PHP=harbor.xakki.ru/library/php:8.5-fpm-dev
DOCKER_IMAGE_MARIADB=harbor.xakki.ru/external/mariadb:12
DOCKER_IMAGE_NGINX=harbor.xakki.ru/external/nginx
DOCKER_IMAGE_KEYDB=harbor.xakki.ru/external/keydb
# AI worker image — Harbor project: convertor (decided 2026-06-23)
DOCKER_IMAGE_AI=harbor.xakki.ru/convertor/worker-ai:latest
DOCKER_IMAGE_NODE=node:22-alpine

EXT_NGINX_PORT=172.17.0.1:10090
EXT_NGINX_PORTS=127.0.0.1:10091
EXT_MYSQL_PORT=127.0.0.1:10092
EXT_REDIS_PORT=127.0.0.1:10093
# fluent-bit host-published ports (bind addr:port). fluentd-forward intake + HTTP metrics.
EXT_FLUENT_PORT=127.0.0.1:10094
EXT_FLUENT_METRIC_PORT=127.0.0.1:10095
EXT_NODE_PORT=127.0.0.1:10096

MARIADB_DATABASE=convertor
MARIADB_USER=convertor
MARIADB_PASSWORD=123456
MARIADB_ROOT_PASSWORD=123456
EXPORTER_USER=exportuser
EXPORTER_PASS=123456
# Optional mariadb extra user; leave empty if unused
MARIADB_PASSWORD_WALL=

# App DB connection passed into php/cron containers. Must match the mariadb
# provisioning above (MARIADB_*). NOTE: the Symfony app actually connects via
# DATABASE_URL in app-symfony/.env — keep both in sync.
DB_HOST=mariadb
DB_USERNAME=convertor
DB_DATABASE=convertor
DB_PASSWORD=123456

# KeyDB auth: keydb.conf has NO requirepass (protected-mode no) for local dev,
# so this MUST stay empty — a non-empty value makes worker AUTH fail.
REDIS_PASSWORD=

# WS-Gateway: block-таймаут (мс) для XREADGROUP ... BLOCK <ms>. Не секрет.
WS_BLOCK_MS=5000
# WS-Gateway: адрес/порт WS-сервера (не секрет). Bearer = WORKER_API_TOKEN (ниже).
WS_HOST=0.0.0.0
WS_PORT=8091
# WS-Gateway: порог inline-результата (байты декодированного payload'а). Не секрет.
WS_RESULT_INLINE_MAX=262144
# WS-Gateway: internal-relay в Symfony (gateway→Symfony persist).
# GATEWAY_INTERNAL_TOKEN — секрет, реальное значение в .env.local (здесь пусто).
GATEWAY_INTERNAL_TOKEN=
SYMFONY_INTERNAL_URL=http://nginx
# Liveness ping/pong (не секрет). Потребляет КЛИЕНТ-воркер (s1-08); сервер только
# отвечает pong. Окно reconnect (interval*missed) держим ≪ idle-порога reclaim (5 мин).
WS_PING_INTERVAL_S=20
WS_LIVENESS_MISSED_PINGS=3
WS_RECONNECT_BACKOFF_BASE_S=1
WS_RECONNECT_BACKOFF_MAX_S=30
WS_RECONNECT_BACKOFF_FACTOR=2
# WS-Gateway reclaim: периодический per-type idle XAUTOCLAIM (не секрет). Reclaim по
# WS-дисконнекту ЗАПРЕЩЁН — только idle-порог. Единый RECLAIM_MIN_IDLE_MS заменён
# per-type map: idle-порог держим ≫ окна reconnect (ping_interval*missed_pings).
RECLAIM_INTERVAL_S=60
RECLAIM_BATCH=10
RECLAIM_IDLE_MS_DOCUMENT=300000
RECLAIM_IDLE_MS_IMAGE=120000
RECLAIM_IDLE_MS_AUDIO=300000
RECLAIM_IDLE_MS_VIDEO=600000
RECLAIM_IDLE_MS_DATA=180000
RECLAIM_IDLE_MS_AI=300000
# WS-клиент воркера (s1-08): стабильный consumer + адрес gateway + прогресс/слоты.
# WORKER_ID — СТАБИЛЬНОЕ имя consumer'а без PID, уникально на экземпляр (мульти-тип —
# на тип); GATEWAY_WS_URL — публичный wss://…/ws/worker/. Не секреты (задаются на деплое).
WORKER_ID=
GATEWAY_WS_URL=ws://ws-gateway:8091/ws/worker/
WS_PROGRESS_INTERVAL_S=1
WS_SLOTS=1
WORK_DIR=

# AI worker pull-API (secrets go in .env.local; empty = feature off)
WORKER_API_TOKEN=
API_BASE_URL=

# Whisper STT model size (tiny / base / small / medium / large)
WHISPER_MODEL=base
# Whisper device + compute type (cpu/cuda; int8/float16 etc.)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Payments are FROZEN (free-with-limits). Leave empty — not required to boot.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

# Buckets: ${S3_BUCKET_PREFIX}-inputs (uploads) + ${S3_BUCKET_PREFIX}-results (outputs).
S3_ENDPOINT=https://apis3.xakki.ru
S3_REGION=us-east-1
S3_KEY=convertor-dev
S3_SECRET=
S3_BUCKET_PREFIX=convertor-dev
S3_DUMP_BUCKET=convertor-dump
S3_USE_PATH_STYLE=true

TELEGRAM_BOT_USERNAME=YouFileConvertBot
