{% extends 'base.html.twig' %}

{% block title %}Вход — Конвертер файлов{% endblock %}

{% block stylesheets %}
    <script src="https://cdn.tailwindcss.com"></script>
    <style>[x-cloak]{display:none !important;}</style>
{% endblock %}

{% block javascripts %}
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
{% endblock %}

{% block body %}
{# reason (?oauth_error=...) → понятный RU-текст. Значения приходят из
   OauthController::errorRedirect() (state/exchange/internal); неизвестная
   причина — общий фолбэк, а не «сырой» код на экране. #}
{% set oauthErrorMessages = {
    'state': 'Сессия входа истекла или недействительна. Попробуйте войти ещё раз.',
    'exchange': 'Не удалось подтвердить вход у провайдера. Попробуйте ещё раз.',
    'internal': 'Внутренняя ошибка при входе. Попробуйте позже.',
} %}
<div x-data="loginPage()" class="flex min-h-screen items-center justify-center bg-slate-50 px-4">
    <div class="w-full max-w-sm rounded-lg border border-slate-200 bg-white p-8 shadow-sm">
        <div class="mb-6 flex items-center justify-center gap-2">
            <span class="text-2xl">⚫️</span>
            <span class="text-lg font-semibold text-slate-800">Конвертер файлов</span>
        </div>
        <h1 class="mb-6 text-center text-xl font-semibold text-slate-800">Вход</h1>

        {% if oauthError is not empty %}
            <div class="mb-4 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" data-testid="oauth-error">
                {{ oauthErrorMessages[oauthError] ?? 'Не удалось войти. Попробуйте ещё раз.' }}
            </div>
        {% endif %}

        <template x-if="authError">
            <div class="mb-4 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" x-text="authError"></div>
        </template>

        {# Соцвход: обычные full-page ссылки на start-эндпоинт (НЕ fetch) —
           OAuth-редирект провайдера всё равно требует полной навигации браузера.
           Порядок VK/Yandex → Google/GitHub — под RU-копирайт страницы
           (визуальный референс: proxy-service/app-front/src/routes/login.tsx). #}
        <div class="space-y-2">
            <a
                href="/api/v1/auth/oauth/vk/start"
                class="flex w-full items-center justify-center gap-2 rounded border border-slate-300 px-3 py-2 text-sm text-slate-700 transition hover:bg-slate-50"
            >
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
                    <rect width="24" height="24" rx="5" fill="#0077FF"/>
                    <text x="12" y="16.5" text-anchor="middle" font-size="10" font-weight="700" font-family="Arial, sans-serif" fill="#fff">VK</text>
                </svg>
                Войти через VK
            </a>
            <a
                href="/api/v1/auth/oauth/yandex/start"
                class="flex w-full items-center justify-center gap-2 rounded border border-slate-300 px-3 py-2 text-sm text-slate-700 transition hover:bg-slate-50"
            >
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
                    <rect width="24" height="24" rx="12" fill="#FC3F1D"/>
                    <text x="12" y="16.5" text-anchor="middle" font-size="13" font-weight="700" font-family="Arial, sans-serif" fill="#fff">Я</text>
                </svg>
                Войти через Yandex
            </a>
            <a
                href="/api/v1/auth/oauth/google/start"
                class="flex w-full items-center justify-center gap-2 rounded border border-slate-300 px-3 py-2 text-sm text-slate-700 transition hover:bg-slate-50"
            >
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                Войти через Google
            </a>
            <a
                href="/api/v1/auth/oauth/github/start"
                class="flex w-full items-center justify-center gap-2 rounded border border-slate-300 px-3 py-2 text-sm text-slate-700 transition hover:bg-slate-50"
            >
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="shrink-0 text-slate-800">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                Войти через GitHub
            </a>
        </div>

        <div class="my-6 flex items-center gap-3 text-xs text-slate-400">
            <div class="h-px flex-1 bg-slate-200"></div>
            <span>или</span>
            <div class="h-px flex-1 bg-slate-200"></div>
        </div>

        {# Кнопка Telegram — переиспользован ТОТ ЖЕ magic-link флоу, что на `/`
           (conversion/index.html.twig::startLogin): POST
           /api/v1/auth/telegram/start → открыть deep-link в новой вкладке,
           без поллинга. Логика продублирована 1:1 в скрипте ниже, чтобы не
           тащить весь converterApp() ради одной кнопки. #}
        <button
            @click="startLogin()"
            :disabled="loggingIn"
            class="flex w-full items-center justify-center gap-2 rounded bg-sky-500 px-3 py-2 text-sm font-medium text-white transition hover:bg-sky-600 disabled:bg-slate-300"
        >
            <span x-show="!loggingIn">Войти через Telegram</span>
            <span x-show="loggingIn" x-cloak>Открываем Telegram…</span>
        </button>

        <template x-if="loginHint">
            <div class="mt-4 rounded border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-800">
                Продолжите в Telegram: нажмите «Войти», затем откройте пришедшую ссылку
                на&nbsp;этом&nbsp;же&nbsp;устройстве.
            </div>
        </template>
    </div>
</div>

<script>
    function loginPage() {
        return {
            loggingIn: false,   // идёт открытие deep-link
            loginHint: false,   // показать инструкцию «завершите в Telegram»
            authError: '',

            // Копия startLogin() из conversion/index.html.twig (см. комментарий
            // там) — тот же magic-link флоу без поллинга: пользователь
            // завершает вход в Telegram и открывает пришедшую ссылку на этом
            // же устройстве.
            async startLogin() {
                if (this.loggingIn) return;
                this.loggingIn = true;
                this.authError = '';
                try {
                    const res = await fetch('/api/v1/auth/telegram/start', {
                        method: 'POST',
                        credentials: 'include',
                    });
                    if (!res.ok) {
                        this.authError = 'Не удалось начать вход через Telegram (' + res.status + ').';
                        return;
                    }
                    const d = await res.json();
                    if (d.deep_link) window.open(d.deep_link, '_blank', 'noopener');
                    this.loginHint = true;
                } catch (e) {
                    this.authError = 'Сетевая ошибка при входе через Telegram.';
                } finally {
                    this.loggingIn = false;
                }
            },
        };
    }
</script>
{% endblock %}
