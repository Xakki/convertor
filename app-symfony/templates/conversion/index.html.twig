{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block body %}
<div
    x-data="converterApp()"
    x-init="init()"
    class="flex flex-1 flex-col"
>
    <main class="mx-auto w-full max-w-3xl px-4 py-8">
        <template x-if="authError">
            <div class="mb-4 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" x-text="authError"></div>
        </template>

        {# Гейт ai/video: конвертация без логина запрещена сервером (403). Ссылка
           на /login — обычная навигация, БЕЗ popup (D1 эпика home-00). #}
        <template x-if="!auth.token && loginRequired">
            <div class="mb-6 flex flex-wrap items-center gap-3 rounded border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
                <span>{{ 'home.ai_gate_message'|trans }}</span>
                <a
                    href="/login"
                    class="rounded bg-sky-500 px-3 py-1 text-xs font-medium text-white hover:bg-sky-600"
                >{{ 'nav.login'|trans }}</a>
            </div>
        </template>

        {# ── home-13 / CNV-30: виджет квот — 4 тира × день/месяц ── #}
        <template x-if="quota.loaded">
            <div class="mb-4 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-xs text-slate-600">
                <div class="mb-2 flex flex-wrap items-center gap-x-6 gap-y-1">
                    <span>
                        <span class="font-medium text-slate-700">{{ 'home.quota.plan_label'|trans }}:</span>
                        <span x-text="quotaPlanLabel"></span>
                    </span>
                    <span>
                        <span class="font-medium text-slate-700">{{ 'home.quota.max_file_label'|trans }}:</span>
                        <span x-text="humanSize(quota.maxUploadBytes)"></span>
                    </span>
                    {# CNV-59: баланс только у залогиненного (не в хедере). #}
                    <template x-if="auth.token">
                        <span class="inline-flex flex-wrap items-center gap-2">
                            <span>
                                <span class="font-medium text-slate-700" x-text="BILLING_I18N.balanceLabel + ':'"></span>
                                <span class="tabular-nums font-medium text-slate-800" x-text="balanceLabel()"></span>
                            </span>
                            <button
                                type="button"
                                @click="openTopUp()"
                                class="rounded bg-indigo-600 px-2 py-0.5 text-[11px] font-medium text-white hover:bg-indigo-700"
                                x-text="BILLING_I18N.topupCta"
                            ></button>
                        </span>
                    </template>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[18rem] text-xs">
                        <thead>
                            <tr class="text-left text-slate-400">
                                <th class="pb-1 pr-3 font-normal">{{ 'home.quota.tier_col'|trans }}</th>
                                <th class="pb-1 pr-3 font-normal">{{ 'home.quota.window_daily'|trans }}</th>
                                <th class="pb-1 font-normal">{{ 'home.quota.window_monthly'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <template x-for="tier in quotaTierOrder" :key="tier">
                                <tr class="border-t border-slate-200/80">
                                    <td class="py-1 pr-3 font-medium text-slate-700">
                                        <span class="inline-flex items-center gap-1">
                                            <span x-text="quotaTierLabel(tier)"></span>
                                            <template x-if="isQuotaTierLocked(tier)">
                                                <span class="font-normal text-slate-400">🔒</span>
                                            </template>
                                        </span>
                                    </td>
                                    <td class="py-1 pr-3 tabular-nums" x-text="quotaWindowLine(tier, quota.tiers?.[tier]?.daily)"></td>
                                    <td class="py-1 tabular-nums" x-text="quotaWindowLine(tier, quota.tiers?.[tier]?.monthly)"></td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
                <template x-if="quota.plan === 'guest'">
                    <p class="mt-2 text-slate-400">{{ 'home.quota.guest_locked_note'|trans }}</p>
                </template>
            </div>
        </template>

        {# ── Форма загрузки и конвертации ── #}
        <div id="convert-form" class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            {# Переключатель режима ввода: Файл (drag&drop, как раньше) / Текст
               (paste без файла, home-02-text-input). #}
            <div class="mb-4 inline-flex rounded-lg border border-slate-200 p-1 text-sm">
                <button
                    type="button"
                    @click="setMode('file')"
                    :class="inputMode === 'file' ? 'bg-indigo-600 text-white' : 'text-slate-600 hover:bg-slate-100'"
                    class="rounded-md px-3 py-1.5 font-medium transition"
                >{{ 'home.input_mode_file'|trans }}</button>
                <button
                    type="button"
                    @click="setMode('text')"
                    :class="inputMode === 'text' ? 'bg-indigo-600 text-white' : 'text-slate-600 hover:bg-slate-100'"
                    class="rounded-md px-3 py-1.5 font-medium transition"
                >{{ 'home.input_mode_text'|trans }}</button>
            </div>

            {# Drag & drop зона (только file-режим) #}
            <template x-if="inputMode === 'file'">
                <div
                    @dragover.prevent="dragging = true"
                    @dragleave.prevent="dragging = false"
                    @drop.prevent="onDrop($event)"
                    @click="$refs.fileInput.click()"
                    :class="dragging ? 'border-indigo-500 bg-indigo-50' : 'border-slate-300'"
                    class="flex cursor-pointer flex-col items-center justify-center rounded-lg border-2 border-dashed px-6 py-10 text-center transition"
                >
                    <svg class="mb-3 h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"/>
                    </svg>
                    <template x-if="!file">
                        <p class="text-sm text-slate-500">{{ 'home.dropzone_hint'|trans }}</p>
                    </template>
                    <template x-if="file">
                        <div class="text-sm">
                            <p class="font-medium text-slate-700" x-text="file.name"></p>
                            <p class="text-slate-400" x-text="humanSize(file.size)"></p>
                        </div>
                    </template>
                    <input type="file" x-ref="fileInput" class="hidden" @change="onFilePick($event)">
                </div>
            </template>

            {# Текстовый ввод (только text-режим): textarea + явный выбор source_format
               (ограниченное текстовое подмножество — см. textSourceFormats). БЕЗ
               синтеза File/Blob на клиенте — submit() шлёт text+source_format полями. #}
            <template x-if="inputMode === 'text'">
                <div>
                    <textarea
                        x-model="text"
                        rows="8"
                        placeholder="{{ 'home.text_placeholder'|trans|e('html_attr') }}"
                        class="w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm focus:border-indigo-500 focus:outline-none"
                    ></textarea>
                    <div class="mt-1 flex items-center justify-between text-xs">
                        <template x-if="text.trim() === ''">
                            <span class="text-slate-400">{{ 'home.error.text_required'|trans }}</span>
                        </template>
                        <template x-if="text.trim() !== '' && textTooLarge">
                            <span class="text-red-600" x-text="I18N.errors.textTooLarge.replace('%mb%', TEXT_SOFT_LIMIT_MB)"></span>
                        </template>
                        <span class="ml-auto text-slate-400" x-text="humanSize(textByteSize)"></span>
                    </div>
                </div>
            </template>

            {# Выбор исходного/целевого формата #}
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <label class="block">
                    <span class="mb-1 block text-sm font-medium text-slate-600">{{ 'home.source_format_label'|trans }}</span>
                    <template x-if="inputMode === 'file'">
                        <input
                            type="text"
                            :value="fromFormat || '—'"
                            disabled
                            class="w-full rounded border border-slate-200 bg-slate-100 px-3 py-2 text-slate-500"
                        >
                    </template>
                    <template x-if="inputMode === 'text'">
                        <select
                            x-model="fromFormat"
                            class="w-full rounded border border-slate-300 px-3 py-2 focus:border-indigo-500 focus:outline-none"
                        >
                            <option value="">{{ 'home.format_placeholder'|trans }}</option>
                            <template x-for="f in textSourceFormats" :key="f">
                                <option :value="f" x-text="f"></option>
                            </template>
                        </select>
                    </template>
                </label>
                <label class="block">
                    <span class="mb-1 block text-sm font-medium text-slate-600">{{ 'home.target_format_label'|trans }}</span>
                    <select
                        x-model="toFormat"
                        :disabled="targets.length === 0"
                        class="w-full rounded border border-slate-300 px-3 py-2 focus:border-indigo-500 focus:outline-none disabled:bg-slate-100"
                    >
                        <option value="">{{ 'home.format_placeholder'|trans }}</option>
                        <template x-for="t in targets" :key="t">
                            <option :value="t" x-text="t"></option>
                        </template>
                    </select>
                </label>
            </div>

            {# OCR toggle: file-режим, только для растр/pdf источников с текстовым таргетом #}
            <label x-show="inputMode === 'file' && showOcr" x-cloak class="mt-4 flex items-center gap-2 text-sm text-slate-700">
                <input type="checkbox" x-model="ocr" class="h-4 w-4 rounded border-slate-300">
                {{ 'home.ocr_label'|trans }}
            </label>

            {# Кнопка отправки #}
            <div class="mt-6">
                <button
                    @click="submit()"
                    :disabled="!canSubmit"
                    class="w-full rounded-lg bg-indigo-600 px-4 py-2.5 font-medium text-white transition hover:bg-indigo-700 disabled:cursor-not-allowed disabled:bg-slate-300"
                >
                    <span x-show="!submitting">{{ 'home.submit_button'|trans }}</span>
                    <span x-show="submitting" x-cloak>{{ 'home.submit_sending'|trans }}</span>
                </button>
            </div>

            {# Ошибка отправки #}
            <template x-if="error">
                <div class="mt-4 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                    <span x-text="error"></span>
                    <template x-if="errorInsufficientBalance">
                        <button
                            type="button"
                            @click="openTopUp()"
                            class="ml-2 inline-flex rounded bg-indigo-600 px-2 py-0.5 text-xs font-medium text-white hover:bg-indigo-700"
                            x-text="BILLING_I18N.topupCta"
                        ></button>
                    </template>
                </div>
            </template>
        </div>

        {# ── Статус задачи и результат — partial (home-09), переиспользуется
           conversion/pair.html.twig без изменений разметки. ── #}
        {% include 'partials/_converter_job_status.html.twig' %}

        {# ── home-04 (Part B): живые примеры конвертаций из S3 — partial
           (home-09), переиспользуется conversion/pair.html.twig без изменений
           разметки (фильтрация до пары/категории — в converterApp() init()). ── #}
        {% include 'partials/_converter_examples.html.twig' %}

        {# ── Витрина категорий/пар форматов (home-03) — целиком из
           GET /api/v1/formats, никакого хардкода списка форматов в Twig/JS.
           Клик по паре — best-effort предзаполнение формы + скролл-якорь к
           #convert-form (id держится на форме выше, позиция витрины на это
           не влияет). home-03-showcase-reorder: блок сознательно ПОСЛЕ формы
           и примеров, сразу ПЕРЕД таблицей поддерживаемых форматов ниже —
           так пользователь сначала видит форму/примеры, а витрина служит
           переходом к полной таблице форматов. #}
        <template x-if="showcaseCategories.length > 0">
            <section class="mb-8">
                <h2 class="text-lg font-semibold text-slate-800">{{ 'home.showcase_heading'|trans }}</h2>
                <p class="mt-1 text-sm text-slate-500">{{ 'home.showcase_subheading'|trans }}</p>
                <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    <template x-for="cat in showcaseCategories" :key="cat.category">
                        <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
                            <h3 class="text-sm font-semibold text-slate-700" x-text="cat.label"></h3>
                            <ul class="mt-3 space-y-1.5">
                                <template x-for="pair in cat.pairs" :key="pair.from + '-' + pair.to">
                                    <li>
                                        <button
                                            type="button"
                                            @click="useShowcasePair(pair.from, pair.to)"
                                            class="flex w-full items-center justify-between gap-2 rounded px-2 py-1 text-left text-sm text-slate-600 transition hover:bg-indigo-50 hover:text-indigo-700"
                                        >
                                            <span>
                                                <span x-text="pair.from"></span>
                                                <span class="text-slate-400"> → </span>
                                                <span x-text="pair.to"></span>
                                            </span>
                                            <span
                                                x-show="pair.isAi === true"
                                                x-cloak
                                                class="rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700"
                                                x-text="I18N.showcase.aiBadge"
                                            ></span>
                                        </button>
                                    </li>
                                </template>
                            </ul>
                            <p x-show="cat.more > 0" x-cloak class="mt-2 px-2 text-xs text-slate-400" x-text="I18N.showcase.more.replace('%count%', cat.more)"></p>
                        </div>
                    </template>
                </div>
            </section>
        </template>

        {# ── home-04 (Part A) / home-11: инфо-блок «форматы + лимиты» ──
           Таблица форматов (home-11) теперь строится клиентски из this.formats
           (formatMatrix getter, partials/_converter_app_script.html.twig) —
           тот же fetch('/api/v1/formats'), что и у витрины/формы выше, второго
           запроса нет. Больше не хардкод: авто-отражает реальную БД-матрицу,
           включая AI-конвертации (STT/TTS/embedding, бейдж как в витрине).
           Тарифная сетка ниже остаётся статичной Twig-разметкой — не эндпоинт
           (GET /api/v1/quota отдаёт лимиты текущего юзера, не публичную сетку).
           Числа лимитов сверены с реальным кодом (QuotaService + план-строки
           миграции Version20260419000001), НЕ с 4-тировой моделью ROADMAP
           (та ещё не реализована — см. limits.proposal_note). #}
        <section class="mt-12">
            <h2 class="text-lg font-semibold text-slate-800">{{ 'home.formats.heading'|trans }}</h2>
            <p class="mt-1 text-sm text-slate-500">{{ 'home.formats.subheading'|trans }}</p>
            <div class="mt-4 overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
                <table class="w-full min-w-[36rem] text-left text-sm">
                    <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase text-slate-500">
                        <tr>
                            <th class="px-4 py-3 font-medium">{{ 'home.formats.col_category'|trans }}</th>
                            <th class="px-4 py-3 font-medium">{{ 'home.formats.col_source'|trans }}</th>
                            <th class="px-4 py-3 font-medium">{{ 'home.formats.col_target'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-600">
                        <template x-for="row in formatMatrix" :key="row.key">
                            <tr>
                                <td class="px-4 py-3 font-medium text-slate-700">
                                    <span x-text="row.label"></span>
                                    <span
                                        x-show="row.isAi"
                                        x-cloak
                                        class="ml-1 rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700"
                                        x-text="I18N.showcase.aiBadge"
                                    ></span>
                                </td>
                                <td class="px-4 py-3 font-mono text-xs" x-text="row.sources.join(', ')"></td>
                                <td class="px-4 py-3 font-mono text-xs" x-text="row.targets.join(', ')"></td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>

            <h2 class="mt-10 text-lg font-semibold text-slate-800">{{ 'home.limits.heading'|trans }}</h2>
            <p class="mt-1 text-sm text-slate-500">{{ 'home.limits.subheading'|trans }}</p>
            <div class="mt-4 overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
                <table class="w-full min-w-[32rem] text-left text-sm">
                    <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase text-slate-500">
                        <tr>
                            <th class="px-4 py-3 font-medium">{{ 'home.limits.col_param'|trans }}</th>
                            <th class="px-4 py-3 font-medium">Free</th>
                            <th class="px-4 py-3 font-medium">Basic</th>
                            <th class="px-4 py-3 font-medium">Pro</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-600">
                        <tr>
                            <td class="px-4 py-3 font-medium text-slate-700">{{ 'home.limits.conversions_day'|trans }}</td>
                            <td class="px-4 py-3">2</td>
                            <td class="px-4 py-3">100</td>
                            <td class="px-4 py-3">∞ <span class="text-xs text-slate-400">({{ 'home.limits.unlimited'|trans }})</span></td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 font-medium text-slate-700">{{ 'home.limits.ai_day'|trans }}</td>
                            <td class="px-4 py-3">1</td>
                            <td class="px-4 py-3">30</td>
                            <td class="px-4 py-3">100</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 font-medium text-slate-700">{{ 'home.limits.max_file'|trans }}</td>
                            <td class="px-4 py-3">50 MB</td>
                            <td class="px-4 py-3">200 MB</td>
                            <td class="px-4 py-3">500 MB</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 font-medium text-slate-700">{{ 'home.limits.price_month'|trans }}</td>
                            <td class="px-4 py-3">$0</td>
                            <td class="px-4 py-3">$3 · 150⭐</td>
                            <td class="px-4 py-3">$10 · 500⭐</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="mt-2 text-xs text-slate-400">{{ 'home.limits.proposal_note'|trans }}</p>
        </section>

        {# ── История конвертаций. Залогиненный — грузится по JWT (tryRefresh),
           не гейтится cookie-согласием. Гость (home-12) — грузится ТОЛЬКО при
           cookie_consent=accepted (см. init()/readConsent() в
           _converter_app_script.html.twig); conversions остаётся [] и секция
           не рендерится, если согласия нет — отдельный запрос сюда не нужен. ── #}
        <template x-if="conversions.length > 0">
            <section class="mt-8">
                <template x-if="auth.token">
                    <h2 class="mb-3 text-sm font-semibold text-slate-600">{{ 'home.history_heading'|trans }}</h2>
                </template>
                <template x-if="!auth.token">
                    <div class="mb-3">
                        <h2 class="text-sm font-semibold text-slate-600">{{ 'home.history_heading_guest'|trans }}</h2>
                        <p class="mt-0.5 text-xs text-slate-400">{{ 'home.history_guest_note'|trans }}</p>
                    </div>
                </template>
                <div class="divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white shadow-sm">
                    <template x-for="c in conversions" :key="c.id">
                        <div class="px-4 py-3">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div class="min-w-0">
                                <p class="text-sm font-medium text-slate-700">
                                    <span x-text="c.from_format || '—'"></span>
                                    <span class="text-slate-400"> → </span>
                                    <span x-text="c.to_format"></span>
                                </p>
                                {# Исходник: имя + размер. Ссылка качается через
                                   authFetch→blob (Bearer). 410 → «исходник удалён». #}
                                <p class="truncate text-xs text-slate-500">
                                    <span x-text="c.source_name"></span>
                                    <span class="text-slate-400" x-text="'· ' + humanSize(c.source_size)"></span>
                                    <template x-if="c.result_size != null">
                                        <span class="text-slate-400" x-text="'→ ' + humanSize(c.result_size)"></span>
                                    </template>
                                </p>
                                <p class="text-xs text-slate-400">
                                    <span x-text="formatDate(c.created_at)"></span>
                                    <template x-if="c.processing_ms != null">
                                        <span x-text="'· ' + I18N.durationPrefix + formatDuration(c.processing_ms)"></span>
                                    </template>
                                </p>
                            </div>
                            <div class="flex flex-wrap items-center justify-end gap-2">
                                <span
                                    class="rounded-full px-3 py-1 text-xs font-medium"
                                    :class="{
                                        'bg-slate-100 text-slate-600': isActive(c.status),
                                        'bg-green-100 text-green-700': c.status === 'completed',
                                        'bg-red-100 text-red-700': isFailed(c.status),
                                    }"
                                    x-text="statusLabel(c.status)"
                                ></span>
                                {# Скачать исходник — прячется после 410 (исходник удалён). #}
                                <template x-if="!sourceGone[c.id]">
                                    <button
                                        @click="downloadSource(c.id, c.source_name)"
                                        :disabled="sourceLoadingId === c.id"
                                        class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 disabled:opacity-50"
                                    >
                                        <span x-show="sourceLoadingId !== c.id">{{ 'home.history_source'|trans }}</span>
                                        <span x-show="sourceLoadingId === c.id" x-cloak>{{ 'common.loading'|trans }}</span>
                                    </button>
                                </template>
                                <template x-if="sourceGone[c.id]">
                                    <span class="text-xs text-slate-400">{{ 'home.history_source_gone'|trans }}</span>
                                </template>
                                {# home-05: тип вьюера по формату/категории (D4 LIGHT MVP) —
                                   text/image/pdf открывают попап, audio/video — инлайн-плеер ниже. #}
                                <template x-if="c.status === 'completed' && viewerTypeForHistory(c) === 'text'">
                                    <button
                                        @click="openPreview(c.id, c.to_format)"
                                        class="rounded-lg border border-indigo-300 px-3 py-1.5 text-xs font-medium text-indigo-600 hover:bg-indigo-50"
                                    >{{ 'home.history_preview'|trans }}</button>
                                </template>
                                <template x-if="c.status === 'completed' && (viewerTypeForHistory(c) === 'image' || viewerTypeForHistory(c) === 'pdf')">
                                    <button
                                        @click="openViewer(viewerTypeForHistory(c), '/api/v1/convert/' + c.id + '/download', false)"
                                        class="rounded-lg border border-indigo-300 px-3 py-1.5 text-xs font-medium text-indigo-600 hover:bg-indigo-50"
                                    >{{ 'home.history_preview'|trans }}</button>
                                </template>
                                <template x-if="c.status === 'completed' && (viewerTypeForHistory(c) === 'audio' || viewerTypeForHistory(c) === 'video')">
                                    <button
                                        @click="togglePlayer('h' + c.id, viewerTypeForHistory(c), '/api/v1/convert/' + c.id + '/download', false)"
                                        class="rounded-lg border border-indigo-300 px-3 py-1.5 text-xs font-medium text-indigo-600 hover:bg-indigo-50"
                                    >
                                        <span x-text="players['h' + c.id] ? I18N.viewer.hidePlayer : I18N.viewer.showPlayer"></span>
                                    </button>
                                </template>
                                <template x-if="c.status === 'completed'">
                                    <button
                                        @click="downloadConversion(c.id, c.to_format)"
                                        :disabled="downloadingId === c.id"
                                        class="rounded-lg bg-green-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-green-700 disabled:bg-slate-300"
                                    >
                                        <span x-show="downloadingId !== c.id">{{ 'common.download'|trans }}</span>
                                        <span x-show="downloadingId === c.id" x-cloak>{{ 'common.loading'|trans }}</span>
                                    </button>
                                </template>
                            </div>
                        </div>
                        {# home-05: инлайн audio/video плеер строки истории — вне flex-строки
                           выше, чтобы плеер занимал всю ширину карточки. #}
                        <template x-if="players['h' + c.id]">
                            <div class="mt-2">
                                <template x-if="players['h' + c.id].loading">
                                    <p class="text-xs text-slate-400">{{ 'common.loading'|trans }}</p>
                                </template>
                                <template x-if="players['h' + c.id].error">
                                    <p class="text-xs text-red-600" x-text="players['h' + c.id].error"></p>
                                </template>
                                <template x-if="players['h' + c.id].objectUrl && players['h' + c.id].type === 'audio'">
                                    {# object URL — источник для <audio>, НЕ HTML-контент (см. модалку вьюера выше). #}
                                    <audio :src="players['h' + c.id].objectUrl" controls class="w-full"></audio>
                                </template>
                                <template x-if="players['h' + c.id].objectUrl && players['h' + c.id].type === 'video'">
                                    {# object URL — источник для <video>, НЕ HTML-контент. #}
                                    <video :src="players['h' + c.id].objectUrl" controls class="max-h-96 w-full"></video>
                                </template>
                            </div>
                        </template>
                        </div>
                    </template>
                </div>
            </section>
        </template>
    </main>

    {# ── Модалки предпросмотра (текст) — partial (home-09), ВНУТРИ x-data,
       переиспользуется conversion/pair.html.twig в той же позиции. ── #}
    {% include 'partials/_converter_preview_modal.html.twig' %}

    {# ── Модалка медиа-вьюера (image/pdf) — partial (home-09). ДОЛЖНА быть
       ВНУТРИ x-data="converterApp()" — иначе viewer.* резолвится в пустом/
       глобальном Alpine-скоупе и вьюер не открывается (баг home-05, найден
       2026-07-21). Переиспользуется conversion/pair.html.twig в той же
       позиции. ── #}
    {% include 'partials/_converter_viewer_modal.html.twig' %}
    {% include 'partials/_billing_topup_modal.html.twig' %}
</div>

{# CNV-59: billing mixin → затем converterApp(). #}
{% include 'partials/_billing_topup_script.html.twig' %}
{% include 'partials/_converter_app_script.html.twig' %}
{% endblock %}
