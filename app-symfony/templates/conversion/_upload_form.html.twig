{#
    Minimal upload form fragment for the convert endpoint (POST /api/v1/convert).
    Self-contained (Alpine.js + HTMX via CDN, no npm). Include it from a page
    template once one exists: {{ include('conversion/_upload_form.html.twig') }}

    NOTE (validate-image-worker): there is no upload PAGE in the project yet
    (only base.html.twig). This fragment is the home for the OCR toggle; wire it
    into a real page when the upload UI lands.
#}
<form
    hx-post="/api/v1/convert"
    hx-encoding="multipart/form-data"
    hx-target="#convert-result"
    hx-swap="innerHTML"
    x-data="{ from: '' }"
    @change="from = ($refs.file.files[0]?.name.split('.').pop() || '').toLowerCase()"
    class="upload-form"
>
    <input type="file" name="file" x-ref="file" required>

    <label>
        Target format
        <input type="text" name="to_format" placeholder="txt / md / docx / pdf …" required>
    </label>

    {# OCR toggle: only meaningful for raster/pdf sources. Submits ocr=1 so the
       backend forces the image worker (text recognition), free quota. #}
    <label x-show="['jpg', 'png', 'tiff', 'pdf'].includes(from)" x-cloak>
        <input type="checkbox" name="ocr" value="1">
        Recognize text (OCR)
    </label>

    <button type="submit">Convert</button>
</form>

<div id="convert-result"></div>
