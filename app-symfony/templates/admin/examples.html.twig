{# Секция управления «живыми примерами» лендинга admin-панели (карточка
   admin-managed-examples). Данные — клиентом через shared-хелпер window.admin.fetch
   (Bearer + refresh/redirect), рендер Alpine. Дизайн портирован из
   users.html.twig/toggle.html.twig. Секретов в разметке нет — всё из gated
   JSON-API /api/v1/admin/examples[/candidates]. id="examples" — якорь боковой
   навигации. Подход A: примером становится СУЩЕСТВУЮЩАЯ конвертация («Сделать
   примером»), не аплоад с нуля. #}
<section id="examples" class="mt-8" aria-labelledby="examples-heading"
         x-data="adminExamples()">
    <div class="flex items-center justify-between">
        <h2 id="examples-heading" class="text-lg font-semibold text-white">Живые примеры</h2>
        <button @click="reloadAll()"
                class="rounded-lg border border-zinc-700 px-3 py-1.5 text-xs text-zinc-300 transition-colors hover:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                :disabled="loading"
                aria-label="Обновить">
            <span x-show="!loading">Обновить</span>
            <span x-show="loading" x-cloak>Загрузка…</span>
        </button>
    </div>
    <p class="mt-1 text-sm text-zinc-500">
        Пример — это ЗАВЕРШЁННАЯ конвертация, помеченная для показа на лендинге.
        Вход и результат копируются в стабильный S3-префикс независимо от
        24-часовой очистки.
    </p>

    {# Ошибка / сообщение #}
    <div x-show="error" x-cloak
         class="mt-4 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300"
         role="alert" x-text="error"></div>
    <div x-show="notice" x-cloak
         class="mt-4 rounded-lg border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-300"
         role="status" x-text="notice"></div>

    {# Текущие примеры #}
    <h3 class="mt-6 text-sm font-semibold uppercase tracking-wider text-zinc-400">Текущие примеры (<span x-text="items.length"></span>)</h3>
    <div class="mt-2 overflow-x-auto rounded-xl border border-zinc-800 bg-zinc-900">
        <table class="min-w-full divide-y divide-zinc-800 text-sm">
            <thead>
                <tr class="text-left text-xs uppercase tracking-wider text-zinc-500">
                    <th class="px-4 py-3">Категория</th>
                    <th class="px-4 py-3">Из → В</th>
                    <th class="px-4 py-3">Файл</th>
                    <th class="px-4 py-3">Размер</th>
                    <th class="px-4 py-3">Конвертация</th>
                    <th class="px-4 py-3 text-right">Действия</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-zinc-800">
                <template x-for="ex in items" :key="ex.id">
                    <tr class="text-zinc-300">
                        <td class="px-4 py-3">
                            <span class="rounded-full bg-zinc-800 px-2.5 py-0.5 text-xs text-zinc-300" x-text="ex.category"></span>
                        </td>
                        <td class="px-4 py-3 font-mono text-white" x-text="ex.from + ' → ' + ex.to"></td>
                        <td class="px-4 py-3 font-mono text-xs text-zinc-400" x-text="ex.filename"></td>
                        <td class="px-4 py-3 text-xs text-zinc-400" x-text="fmtSize(ex.size)"></td>
                        <td class="px-4 py-3 text-xs text-zinc-500" x-text="ex.conversionId ? ('#' + ex.conversionId) : '—'"></td>
                        <td class="px-4 py-3">
                            <div class="flex justify-end">
                                <button @click="remove(ex)"
                                        class="rounded border border-red-500/40 px-2 py-1 text-xs text-red-400 transition-colors hover:bg-red-500/10"
                                        :disabled="loading">Убрать из примеров</button>
                            </div>
                        </td>
                    </tr>
                </template>
                <tr x-show="!loading && items.length === 0" x-cloak>
                    <td colspan="6" class="px-4 py-6 text-center text-sm text-zinc-500">Примеров пока нет</td>
                </tr>
            </tbody>
        </table>
    </div>

    {# Кандидаты на промо #}
    <h3 class="mt-8 text-sm font-semibold uppercase tracking-wider text-zinc-400">Завершённые конвертации</h3>
    <form class="mt-2 flex gap-2" @submit.prevent="searchCandidates()">
        <input type="text" x-model="q" placeholder="ID конвертации, ID или email пользователя"
               class="flex-1 rounded-lg border border-zinc-700 bg-zinc-900 px-3 py-2 text-sm text-white placeholder-zinc-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
               aria-label="Поиск конвертаций">
        <button type="submit"
                class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                :disabled="loading">Найти</button>
    </form>

    <div class="mt-4 overflow-x-auto rounded-xl border border-zinc-800 bg-zinc-900">
        <table class="min-w-full divide-y divide-zinc-800 text-sm">
            <thead>
                <tr class="text-left text-xs uppercase tracking-wider text-zinc-500">
                    <th class="px-4 py-3">ID</th>
                    <th class="px-4 py-3">Пользователь</th>
                    <th class="px-4 py-3">Категория</th>
                    <th class="px-4 py-3">Из → В</th>
                    <th class="px-4 py-3">Размер результата</th>
                    <th class="px-4 py-3">Создана</th>
                    <th class="px-4 py-3 text-right">Действия</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-zinc-800">
                <template x-for="c in candidates" :key="c.id">
                    <tr class="text-zinc-300">
                        <td class="px-4 py-3 font-mono text-zinc-400" x-text="c.id"></td>
                        <td class="px-4 py-3 text-xs" x-text="c.userEmail || '—'"></td>
                        <td class="px-4 py-3">
                            <span class="rounded-full bg-zinc-800 px-2.5 py-0.5 text-xs text-zinc-300" x-text="c.category"></span>
                        </td>
                        <td class="px-4 py-3 font-mono text-white" x-text="c.from + ' → ' + c.to"></td>
                        <td class="px-4 py-3 text-xs text-zinc-400" x-text="fmtSize(c.resultSize)"></td>
                        <td class="px-4 py-3 text-xs text-zinc-500" x-text="fmtDate(c.createdAt)"></td>
                        <td class="px-4 py-3">
                            <div class="flex justify-end">
                                <button @click="promote(c)"
                                        class="rounded border border-indigo-500/50 px-2 py-1 text-xs text-indigo-300 transition-colors hover:bg-indigo-500/10"
                                        :disabled="loading">Сделать примером</button>
                            </div>
                        </td>
                    </tr>
                </template>
                <tr x-show="!loading && candidates.length === 0" x-cloak>
                    <td colspan="7" class="px-4 py-6 text-center text-sm text-zinc-500">Нет завершённых конвертаций</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="mt-3 flex items-center justify-between text-sm text-zinc-400" x-show="candTotal > 0" x-cloak>
        <span>Всего: <span class="text-white" x-text="candTotal"></span></span>
        <div class="flex items-center gap-3">
            <button @click="gotoCandidates(candPage - 1)" :disabled="candPage <= 1 || loading"
                    class="rounded-lg border border-zinc-700 px-3 py-1.5 text-xs transition-colors hover:bg-zinc-800 disabled:opacity-40">← Назад</button>
            <span>Стр. <span class="text-white" x-text="candPage"></span> из <span x-text="candPages"></span></span>
            <button @click="gotoCandidates(candPage + 1)" :disabled="candPage >= candPages || loading"
                    class="rounded-lg border border-zinc-700 px-3 py-1.5 text-xs transition-colors hover:bg-zinc-800 disabled:opacity-40">Вперёд →</button>
        </div>
    </div>
</section>

<script>
    // Alpine-компонент секции примеров. Все запросы — через shared
    // window.admin.fetch (Bearer + refresh/redirect). Определён до deferred-Alpine.
    function adminExamples() {
        return {
            loading: true,
            error: '',
            notice: '',
            items: [],
            q: '',
            candidates: [],
            candPage: 1,
            candPages: 1,
            candTotal: 0,

            async init() {
                const ok = await window.admin.ready;
                if (!ok) {
                    return;
                }
                await this.reloadAll();
            },

            async reloadAll() {
                await Promise.all([this.reloadExamples(), this.reloadCandidates()]);
            },

            searchCandidates() {
                this.candPage = 1;
                return this.reloadCandidates();
            },

            gotoCandidates(p) {
                if (p < 1 || p > this.candPages || p === this.candPage) {
                    return;
                }
                this.candPage = p;
                return this.reloadCandidates();
            },

            async reloadExamples() {
                this.loading = true;
                this.error = '';
                try {
                    const res = await window.admin.fetch('/api/v1/admin/examples');
                    if (!res.ok) {
                        this.error = 'Не удалось загрузить примеры (' + res.status + ')';
                        return;
                    }
                    const data = await res.json();
                    this.items = data.items || [];
                } catch (e) {
                    this.error = 'Ошибка сети при загрузке примеров';
                } finally {
                    this.loading = false;
                }
            },

            async reloadCandidates() {
                this.loading = true;
                this.error = '';
                try {
                    const url = '/api/v1/admin/examples/candidates?q=' + encodeURIComponent(this.q) + '&page=' + this.candPage;
                    const res = await window.admin.fetch(url);
                    if (!res.ok) {
                        this.error = 'Не удалось загрузить конвертации (' + res.status + ')';
                        return;
                    }
                    const data = await res.json();
                    this.candidates = data.items || [];
                    this.candTotal = data.total || 0;
                    this.candPages = data.pages || 1;
                    this.candPage = data.page || 1;
                } catch (e) {
                    this.error = 'Ошибка сети при загрузке конвертаций';
                } finally {
                    this.loading = false;
                }
            },

            async promote(c) {
                if (!confirm('Сделать конвертацию #' + c.id + ' (' + c.from + ' → ' + c.to + ') примером на лендинге?')) {
                    return;
                }
                this.loading = true;
                this.error = '';
                this.notice = '';
                try {
                    const res = await window.admin.fetch('/api/v1/admin/examples/' + c.id + '/promote', { method: 'POST' });
                    if (!res.ok) {
                        const body = await res.json().catch(() => ({}));
                        this.error = body.message || ('Не удалось сделать примером (' + res.status + ')');
                        return;
                    }
                    this.notice = 'Конвертация #' + c.id + ' стала примером';
                    await this.reloadAll();
                } catch (e) {
                    this.error = 'Ошибка сети при промо';
                } finally {
                    this.loading = false;
                }
            },

            async remove(ex) {
                if (!confirm('Убрать пример ' + ex.category + ': ' + ex.from + ' → ' + ex.to + ' с лендинга?')) {
                    return;
                }
                this.loading = true;
                this.error = '';
                this.notice = '';
                try {
                    const res = await window.admin.fetch('/api/v1/admin/examples/' + ex.id + '/remove', { method: 'POST' });
                    if (!res.ok) {
                        this.error = 'Не удалось убрать пример (' + res.status + ')';
                        return;
                    }
                    this.items = this.items.filter((i) => i.id !== ex.id);
                    this.notice = 'Пример убран с лендинга';
                } catch (e) {
                    this.error = 'Ошибка сети при удалении примера';
                } finally {
                    this.loading = false;
                }
            },

            fmtSize(bytes) {
                if (bytes == null) {
                    return '—';
                }
                if (bytes < 1024) {
                    return bytes + ' Б';
                }
                if (bytes < 1024 * 1024) {
                    return (bytes / 1024).toFixed(1) + ' КБ';
                }
                return (bytes / (1024 * 1024)).toFixed(1) + ' МБ';
            },

            fmtDate(s) {
                if (!s) {
                    return '—';
                }
                const d = new Date(s);
                return isNaN(d) ? s : d.toLocaleDateString('ru-RU');
            },
        };
    }
</script>
