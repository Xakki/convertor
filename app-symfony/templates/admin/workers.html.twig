{# Секция обзора воркеров admin-панели (registry-07, финальный шаг эпика
   registry-00-self-registration). Данные тянутся клиентом через shared-хелпер
   window.admin.fetch (Bearer + refresh/redirect) из gated JSON-API
   /api/v1/admin/workers и рендерятся Alpine. Live-обновление — poll каждые
   15 c (реже, чем очереди: список воркеров меняется медленнее, чем длина
   стрима). Секретов в разметке нет. id="workers" — якорь боковой навигации.

   Seed-строки (instanceId='__seed__', registry-03) — НЕ мёртвые воркеры, а
   статичный снимок матрицы; их lastSeen всегда старый (миграция применилась
   один раз, liveness-пуш они никогда не получают) — поэтому показываем их с
   отдельным нейтральным бейджем "Seed" ВМЕСТО alive/stale-индикатора, а не
   как воркер, который вот-вот истечёт по TTL.

   `status` (alive/disconnected/unknown) и `stale` (lastSeen старше TTL) —
   ДВА РАЗНЫХ факта, показываем раздельными бейджами, не схлопываем в один
   светофор: воркер может быть alive по статусу, но давно не пинговать (или
   наоборот, недавно отметился как disconnected, но TTL ещё не истёк). #}
<section id="workers" class="mt-8" aria-labelledby="workers-heading"
         x-data="adminWorkers()" x-init="init()">
    <div class="flex items-center justify-between">
        <h2 id="workers-heading" class="text-lg font-semibold text-white">Воркеры</h2>
        <div class="flex items-center gap-3">
            <span class="text-xs text-zinc-500" x-show="updatedAt" x-cloak>
                Обновлено <span x-text="updatedAt"></span>
            </span>
            <button @click="reload()"
                    class="rounded-lg border border-zinc-700 px-3 py-1.5 text-xs text-zinc-300 transition-colors hover:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                    :disabled="loading"
                    aria-label="Обновить воркеров">
                <span x-show="!loading">Обновить</span>
                <span x-show="loading" x-cloak>Загрузка…</span>
            </button>
        </div>
    </div>

    <div class="mt-1 flex flex-wrap items-center gap-3 text-xs text-zinc-500">
        <span x-show="ttlHours" x-cloak>
            GC-TTL: <span class="font-mono" x-text="ttlHours"></span> ч
            — строка без пинга дольше этого срока становится кандидатом на удаление
        </span>
        {# НЕ дублируем getCapabilityWarnings() — та логика и её вывод живут
           на /admin/queues, здесь только ссылка. #}
        <a href="#queues" class="text-indigo-400 hover:text-indigo-300 hover:underline">
            Предупреждения о matrix_categories — см. Очереди →
        </a>
    </div>

    {# Ошибка #}
    <div x-show="error" x-cloak
         class="mt-4 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300"
         role="alert" x-text="error"></div>

    <div class="mt-4 overflow-x-auto rounded-xl border border-zinc-800 bg-zinc-900">
        <table class="min-w-full divide-y divide-zinc-800 text-sm">
            <thead>
                <tr class="text-left text-xs uppercase tracking-wider text-zinc-500">
                    <th class="px-4 py-3">Тип / инстанс</th>
                    <th class="px-4 py-3">Статус</th>
                    <th class="px-4 py-3">Свежесть</th>
                    <th class="px-4 py-3">Образ / версия</th>
                    <th class="px-4 py-3">Виден</th>
                    <th class="px-4 py-3 text-right">Пар</th>
                    <th class="px-4 py-3"></th>
                </tr>
            </thead>
            <template x-for="w in workers" :key="w.workerType + '|' + w.instanceId">
                <tbody x-data="{ expanded: false }" class="divide-y divide-zinc-800">
                    <tr class="cursor-pointer text-zinc-300 transition-colors hover:bg-zinc-800/50"
                        @click="expanded = !expanded">
                        <td class="px-4 py-3">
                            <div class="font-mono text-white" x-text="w.workerType"></div>
                            <div class="flex items-center gap-1.5 text-xs text-zinc-500">
                                <span x-show="w.isSeed" x-cloak
                                      class="rounded-full bg-zinc-700 px-2 py-0.5 text-zinc-300"
                                      title="Статичный снимок матрицы из registry-03 seed-миграции, не живой процесс">
                                    Seed
                                </span>
                                <span class="font-mono" x-text="w.instanceId"></span>
                            </div>
                        </td>
                        <td class="px-4 py-3">
                            {# Факт №1: liveness-статус (alive/disconnected/unknown) —
                               НЕ то же самое, что свежесть lastSeen (соседняя колонка). #}
                            <template x-if="w.isSeed">
                                <span class="rounded-full bg-zinc-700 px-2.5 py-0.5 text-xs text-zinc-300">
                                    не отслеживается (seed)
                                </span>
                            </template>
                            <template x-if="!w.isSeed">
                                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs"
                                      :class="statusClass(w.status)">
                                    <span class="h-1.5 w-1.5 rounded-full" :class="statusDotClass(w.status)"></span>
                                    <span x-text="statusLabel(w.status)"></span>
                                </span>
                            </template>
                        </td>
                        <td class="px-4 py-3">
                            {# Факт №2: возраст lastSeen относительно GC-TTL. Для seed —
                               дата seed-миграции, без alive/stale-тревоги (не воркер). #}
                            <template x-if="w.isSeed">
                                <span class="text-xs text-zinc-500" x-text="fmtDate(w.lastSeen)"></span>
                            </template>
                            <template x-if="!w.isSeed">
                                <div>
                                    <span class="rounded-full px-2.5 py-0.5 text-xs"
                                          :class="w.stale ? 'bg-red-500/15 text-red-400' : 'bg-green-500/15 text-green-400'"
                                          x-text="w.stale ? 'устарел' : 'свежий'"></span>
                                    <div class="mt-1 text-xs text-zinc-500" x-text="fmtDate(w.lastSeen)"></div>
                                </div>
                            </template>
                        </td>
                        <td class="px-4 py-3 text-xs">
                            <div class="font-mono text-zinc-300" x-text="w.version || '—'"></div>
                            <div class="font-mono text-zinc-600" x-text="w.image || ''"></div>
                        </td>
                        <td class="px-4 py-3 text-xs text-zinc-500">
                            <span x-text="w.isSeed ? 'из seed-миграции' : 'из register()'"></span>
                        </td>
                        <td class="px-4 py-3 text-right font-mono" x-text="w.pairCount"></td>
                        <td class="px-4 py-3 text-right text-zinc-500">
                            <span x-text="expanded ? '▲' : '▼'" aria-hidden="true"></span>
                        </td>
                    </tr>
                    <tr x-show="expanded" x-cloak>
                        <td colspan="7" class="bg-zinc-950/40 px-4 py-4">
                            <h4 class="mb-2 text-xs font-semibold uppercase tracking-wider text-zinc-500">
                                Матрица пар (source → target)
                            </h4>
                            <div class="grid grid-cols-1 gap-1.5 sm:grid-cols-2 lg:grid-cols-3">
                                <template x-for="(targets, from) in w.matrix" :key="from">
                                    <div class="rounded-lg bg-zinc-800/60 px-2.5 py-1.5 text-xs">
                                        <span class="font-mono text-white" x-text="from"></span>
                                        <span class="text-zinc-600">→</span>
                                        <span class="font-mono text-zinc-300" x-text="targets.join(', ')"></span>
                                    </div>
                                </template>
                            </div>
                            <p x-show="Object.keys(w.matrix).length === 0" x-cloak class="text-xs text-zinc-500">
                                Матрица пуста.
                            </p>
                        </td>
                    </tr>
                </tbody>
            </template>
            <tbody>
                <tr x-show="!loading && workers.length === 0" x-cloak>
                    <td colspan="7" class="px-4 py-6 text-center text-sm text-zinc-500">Нет данных</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<script>
    // Alpine-компонент секции воркеров. Все запросы — через shared
    // window.admin.fetch (Bearer + refresh/redirect). Live-poll каждые 15 c
    // (список воркеров/lastSeen меняется медленнее очередей); интервал
    // гасится при уничтожении компонента (x-destroy).
    function adminWorkers() {
        return {
            loading: true,
            error: '',
            ttlHours: null,
            workers: [],
            updatedAt: '',
            _timer: null,

            async init() {
                const ok = await window.admin.ready;
                if (!ok) {
                    return;
                }
                await this.reload();
                this._timer = setInterval(() => this.reload(), 15000);
            },

            destroy() {
                if (this._timer) {
                    clearInterval(this._timer);
                    this._timer = null;
                }
            },

            async reload() {
                this.loading = true;
                this.error = '';
                try {
                    const res = await window.admin.fetch('/api/v1/admin/workers');
                    if (!res.ok) {
                        this.error = 'Не удалось загрузить воркеров (' + res.status + ')';
                        return;
                    }
                    const data = await res.json();
                    this.ttlHours = data.ttlHours ?? null;
                    this.workers = data.workers || [];
                    this.updatedAt = new Date().toLocaleTimeString('ru-RU');
                } catch (e) {
                    this.error = 'Ошибка сети при загрузке воркеров';
                } finally {
                    this.loading = false;
                }
            },

            fmtDate(iso) {
                if (!iso) {
                    return '—';
                }
                return new Date(iso).toLocaleString('ru-RU');
            },

            statusLabel(status) {
                const map = { alive: 'alive', disconnected: 'disconnected', unknown: 'unknown' };
                return map[status] || status;
            },

            statusClass(status) {
                if (status === 'alive') {
                    return 'bg-green-500/15 text-green-400';
                }
                if (status === 'disconnected') {
                    return 'bg-yellow-500/15 text-yellow-400';
                }
                return 'bg-zinc-700 text-zinc-300';
            },

            statusDotClass(status) {
                if (status === 'alive') {
                    return 'bg-green-400';
                }
                if (status === 'disconnected') {
                    return 'bg-yellow-400';
                }
                return 'bg-zinc-400';
            },
        };
    }
</script>
