{# Секция мониторинга очередей admin-панели (эпик admin-panel, подзадача queues).
   Данные тянутся клиентом через shared-хелпер window.admin.fetch (Bearer +
   refresh/redirect) из gated JSON-API /api/v1/admin/queues и рендерятся Alpine.
   Live-обновление — poll каждые 10 c. Источник метрик — metrics_exporter
   (Prometheus-sidecar) + БД; недоступность exporter'а не роняет секцию. Секретов
   в разметке нет. id="queues" — якорь боковой навигации. #}
<section id="queues" class="mt-8" aria-labelledby="queues-heading"
         x-data="adminQueues()">
    <div class="flex items-center justify-between">
        <h2 id="queues-heading" class="text-lg font-semibold text-white">Очереди</h2>
        <div class="flex items-center gap-3">
            <span class="text-xs text-zinc-500" x-show="updatedAt" x-cloak>
                Обновлено <span x-text="updatedAt"></span>
            </span>
            <button @click="reload()"
                    class="rounded-lg border border-zinc-700 px-3 py-1.5 text-xs text-zinc-300 transition-colors hover:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                    :disabled="loading"
                    aria-label="Обновить очереди">
                <span x-show="!loading">Обновить</span>
                <span x-show="loading" x-cloak>Загрузка…</span>
            </button>
        </div>
    </div>

    {# Статус источников #}
    <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
        <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5"
              :class="exporterAvailable ? 'bg-green-500/15 text-green-400' : 'bg-yellow-500/15 text-yellow-400'">
            <span class="h-1.5 w-1.5 rounded-full" :class="exporterAvailable ? 'bg-green-400' : 'bg-yellow-400'"></span>
            <span x-text="exporterAvailable ? 'exporter доступен' : 'exporter недоступен'"></span>
        </span>
        <span x-show="exporterAvailable && keydbUp === false" x-cloak
              class="inline-flex items-center gap-1.5 rounded-full bg-red-500/15 px-2.5 py-0.5 text-red-400">
            KeyDB недоступен
        </span>
        <span x-show="deadLetter !== null && deadLetter > 0" x-cloak
              class="inline-flex items-center gap-1.5 rounded-full bg-red-500/15 px-2.5 py-0.5 text-red-400">
            DLQ (conv.dead): <span class="font-mono" x-text="deadLetter"></span>
        </span>
    </div>

    {# Ошибка #}
    <div x-show="error" x-cloak
         class="mt-4 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300"
         role="alert" x-text="error"></div>

    {# Warnings: AI-воркер объявил формат в matrix, но нет matrix_categories —
       пара молча отброшена из routing-матрицы (защита на бэке — было видно
       только в логе, теперь видно в admin). #}
    <div x-show="warnings.length > 0" x-cloak class="mt-4 space-y-2">
        <template x-for="w in warnings" :key="w.workerType">
            <div class="rounded-lg border border-yellow-500/30 bg-yellow-500/10 px-4 py-3 text-sm text-yellow-300"
                 role="alert">
                <span aria-hidden="true">⚠</span>
                Воркер <span class="font-mono" x-text="w.workerType"></span>:
                <span class="font-mono" x-text="w.droppedCount"></span> из
                <span class="font-mono" x-text="w.totalFormats"></span> форматов отброшено —
                нет matrix_categories
                (<span class="font-mono" x-text="w.droppedFormats.join(', ')"></span>)
            </div>
        </template>
    </div>

    {# Таблица стримов conv.<type> #}
    <div class="mt-4 overflow-x-auto rounded-xl border border-zinc-800 bg-zinc-900">
        <table class="min-w-full divide-y divide-zinc-800 text-sm">
            <thead>
                <tr class="text-left text-xs uppercase tracking-wider text-zinc-500">
                    <th class="px-4 py-3">Стрим</th>
                    <th class="px-4 py-3 text-right">Длина</th>
                    <th class="px-4 py-3 text-right">В работе (PEL)</th>
                    <th class="px-4 py-3 text-right">Backlog (lag)</th>
                    <th class="px-4 py-3 text-right">Consumers</th>
                    <th class="px-4 py-3 text-right">Макс. idle</th>
                    <th class="px-4 py-3">Сигналы</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-zinc-800">
                <template x-for="s in streams" :key="s.stream">
                    <tr class="text-zinc-300" :class="s.signals.length ? 'bg-red-500/5' : ''">
                        <td class="px-4 py-3 font-mono text-white" x-text="s.stream"></td>
                        <td class="px-4 py-3 text-right font-mono" x-text="fmt(s.length)"></td>
                        <td class="px-4 py-3 text-right font-mono" x-text="fmt(s.pending)"></td>
                        <td class="px-4 py-3 text-right font-mono"
                            :class="s.lag > 0 ? 'text-yellow-400' : ''" x-text="fmt(s.lag)"></td>
                        <td class="px-4 py-3 text-right font-mono"
                            :class="s.consumers === 0 ? 'text-red-400' : ''" x-text="fmt(s.consumers)"></td>
                        <td class="px-4 py-3 text-right font-mono" x-text="fmtIdle(s.maxIdleMs)"></td>
                        <td class="px-4 py-3">
                            <div class="flex flex-wrap gap-1">
                                <template x-for="sig in s.signals" :key="sig">
                                    <span class="rounded-full bg-red-500/15 px-2 py-0.5 text-xs text-red-400"
                                          x-text="signalLabel(sig)"></span>
                                </template>
                                <span x-show="!s.signals.length" class="text-xs text-zinc-600">—</span>
                            </div>
                        </td>
                    </tr>
                </template>
                <tr x-show="!loading && streams.length === 0" x-cloak>
                    <td colspan="7" class="px-4 py-6 text-center text-sm text-zinc-500">Нет данных</td>
                </tr>
            </tbody>
        </table>
    </div>

    {# Застрявшие задачи из БД (Pending/Processing старше порога) #}
    <div class="mt-6">
        <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold text-white">
                Зависшие задачи (БД)
                <span class="ml-1 text-xs font-normal text-zinc-500"
                      x-text="'старше ' + dbStuck.thresholdMinutes + ' мин'"></span>
            </h3>
            <span class="rounded-full px-2.5 py-0.5 text-xs"
                  :class="dbStuck.count > 0 ? 'bg-red-500/15 text-red-400' : 'bg-zinc-800 text-zinc-400'"
                  x-text="'всего: ' + dbStuck.count"></span>
        </div>
        <div class="mt-3 overflow-x-auto rounded-xl border border-zinc-800 bg-zinc-900"
             x-show="dbStuck.items.length > 0" x-cloak>
            <table class="min-w-full divide-y divide-zinc-800 text-sm">
                <thead>
                    <tr class="text-left text-xs uppercase tracking-wider text-zinc-500">
                        <th class="px-4 py-3">ID</th>
                        <th class="px-4 py-3">Статус</th>
                        <th class="px-4 py-3">Конвертация</th>
                        <th class="px-4 py-3 text-right">Возраст</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800">
                    <template x-for="j in dbStuck.items" :key="j.id">
                        <tr class="text-zinc-300">
                            <td class="px-4 py-3 font-mono text-zinc-400" x-text="j.id"></td>
                            <td class="px-4 py-3">
                                <span class="rounded-full bg-yellow-500/15 px-2.5 py-0.5 text-xs text-yellow-400" x-text="j.status"></span>
                            </td>
                            <td class="px-4 py-3 font-mono text-xs" x-text="j.from + ' → ' + j.to"></td>
                            <td class="px-4 py-3 text-right font-mono text-xs text-zinc-400" x-text="j.ageMinutes + ' мин'"></td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
        <p x-show="dbStuck.items.length === 0" x-cloak class="mt-3 text-sm text-zinc-500">Зависших задач нет.</p>
    </div>
</section>

<script>
    // Alpine-компонент секции очередей. Все запросы — через shared window.admin.fetch
    // (Bearer + refresh/redirect). Live-poll каждые 10 c; интервал гасится при
    // уничтожении компонента (x-destroy).
    function adminQueues() {
        return {
            loading: true,
            error: '',
            exporterAvailable: false,
            keydbUp: null,
            deadLetter: null,
            streams: [],
            dbStuck: { count: 0, thresholdMinutes: 0, items: [] },
            warnings: [],
            updatedAt: '',
            _timer: null,

            async init() {
                const ok = await window.admin.ready;
                if (!ok) {
                    return;
                }
                await this.reload();
                // Live-обновление раз в 10 c.
                this._timer = setInterval(() => this.reload(), 10000);
            },

            // Alpine v3 сам зовёт destroy() при удалении компонента — гасим poll.
            destroy() {
                if (this._timer) {
                    clearInterval(this._timer);
                    this._timer = null;
                }
            },

            async reload() {
                this.loading = true;
                this.error = '';
                try {
                    const res = await window.admin.fetch('/api/v1/admin/queues');
                    if (!res.ok) {
                        this.error = 'Не удалось загрузить очереди (' + res.status + ')';
                        return;
                    }
                    const data = await res.json();
                    this.exporterAvailable = !!data.exporterAvailable;
                    this.keydbUp = data.keydbUp;
                    this.deadLetter = data.deadLetter;
                    this.streams = data.streams || [];
                    this.dbStuck = data.dbStuck || { count: 0, thresholdMinutes: 0, items: [] };
                    this.warnings = data.warnings || [];
                    this.updatedAt = new Date().toLocaleTimeString('ru-RU');
                } catch (e) {
                    this.error = 'Ошибка сети при загрузке очередей';
                } finally {
                    this.loading = false;
                }
            },

            fmt(v) {
                return (v === null || v === undefined) ? '—' : v;
            },

            fmtIdle(ms) {
                if (ms === null || ms === undefined) {
                    return '—';
                }
                if (ms < 1000) {
                    return ms + ' мс';
                }
                const s = Math.round(ms / 1000);
                if (s < 60) {
                    return s + ' с';
                }
                return Math.round(s / 60) + ' мин';
            },

            signalLabel(sig) {
                const map = { idle: 'idle >5м', stalled: 'stalled (0 consumers)' };
                return map[sig] || sig;
            },
        };
    }
</script>
