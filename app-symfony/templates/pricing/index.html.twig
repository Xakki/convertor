{% extends 'base.html.twig' %}

{# CNV-59: /pricing — Free/Basic/Pro карточки; подписки disabled/«скоро»;
   top-up packs — живой Telegram-флоу через shared billing modal. #}

{% block title %}{{ 'pricing.title'|trans }}{% endblock %}

{% block body %}
<div
    x-data="pricingApp()"
    x-init="init()"
    class="flex flex-1 flex-col"
>
    <main class="mx-auto w-full max-w-5xl px-4 py-10">
        <header class="mb-10 text-center">
            <h1 class="text-3xl font-semibold text-slate-800">{{ 'pricing.heading'|trans }}</h1>
            <p class="mt-2 text-sm text-slate-500">{{ 'pricing.subheading'|trans }}</p>
        </header>

        <section class="grid grid-cols-1 gap-6 md:grid-cols-3" aria-label="{{ 'pricing.plans_aria'|trans }}">
            {# Free #}
            <article class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="text-lg font-semibold text-slate-800">Free</h2>
                <p class="mt-1 text-sm text-slate-500">{{ 'pricing.free.blurb'|trans }}</p>
                <p class="mt-4 text-3xl font-bold text-slate-900">$0<span class="text-base font-normal text-slate-400">{{ 'pricing.per_month'|trans }}</span></p>
                <ul class="mt-6 flex-1 space-y-2 text-sm text-slate-600">
                    <li>{{ 'pricing.free.f1'|trans }}</li>
                    <li>{{ 'pricing.free.f2'|trans }}</li>
                    <li>{{ 'pricing.free.f3'|trans }}</li>
                    <li>{{ 'pricing.free.f4'|trans }}</li>
                </ul>
                <button type="button" disabled class="mt-6 w-full cursor-default rounded-lg border border-slate-200 py-2.5 text-sm font-medium text-slate-400">
                    {{ 'pricing.cta_current_or_free'|trans }}
                </button>
            </article>

            {# Basic #}
            <article class="relative flex flex-col rounded-xl border-2 border-indigo-500 bg-white p-6 shadow-sm">
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-indigo-600 px-3 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white">
                    {{ 'pricing.popular'|trans }}
                </span>
                <h2 class="text-lg font-semibold text-slate-800">Basic</h2>
                <p class="mt-1 text-sm text-slate-500">{{ 'pricing.basic.blurb'|trans }}</p>
                <p class="mt-4 text-3xl font-bold text-slate-900">$3<span class="text-base font-normal text-slate-400">{{ 'pricing.per_month'|trans }}</span></p>
                <ul class="mt-6 flex-1 space-y-2 text-sm text-slate-600">
                    <li>{{ 'pricing.basic.f1'|trans }}</li>
                    <li>{{ 'pricing.basic.f2'|trans }}</li>
                    <li>{{ 'pricing.basic.f3'|trans }}</li>
                    <li>{{ 'pricing.basic.f4'|trans }}</li>
                </ul>
                <button type="button" disabled class="mt-6 w-full cursor-default rounded-lg border border-indigo-200 bg-indigo-50 py-2.5 text-sm font-medium text-indigo-400">
                    {{ 'pricing.cta_soon'|trans }}
                </button>
            </article>

            {# Pro #}
            <article class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="text-lg font-semibold text-slate-800">Pro</h2>
                <p class="mt-1 text-sm text-slate-500">{{ 'pricing.pro.blurb'|trans }}</p>
                <p class="mt-4 text-3xl font-bold text-slate-900">$10<span class="text-base font-normal text-slate-400">{{ 'pricing.per_month'|trans }}</span></p>
                <ul class="mt-6 flex-1 space-y-2 text-sm text-slate-600">
                    <li>{{ 'pricing.pro.f1'|trans }}</li>
                    <li>{{ 'pricing.pro.f2'|trans }}</li>
                    <li>{{ 'pricing.pro.f3'|trans }}</li>
                    <li>{{ 'pricing.pro.f4'|trans }}</li>
                    <li>{{ 'pricing.pro.f5'|trans }}</li>
                </ul>
                <button type="button" disabled class="mt-6 w-full cursor-default rounded-lg border border-slate-200 py-2.5 text-sm font-medium text-slate-400">
                    {{ 'pricing.cta_soon'|trans }}
                </button>
            </article>
        </section>

        {# Prepaid top-up #}
        <section class="mt-12 rounded-xl border border-slate-200 bg-slate-50 p-6">
            <h2 class="text-lg font-semibold text-slate-800">{{ 'pricing.topup.heading'|trans }}</h2>
            <p class="mt-1 text-sm text-slate-500">{{ 'pricing.topup.subheading'|trans }}</p>
            <div class="mt-4 flex flex-wrap items-center gap-3">
                <template x-if="quota.loaded && loggedIn">
                    <p class="text-sm text-slate-700">
                        <span class="font-medium" x-text="BILLING_I18N.balanceLabel + ':'"></span>
                        <span class="tabular-nums font-semibold" x-text="balanceLabel()"></span>
                    </p>
                </template>
                <button
                    type="button"
                    @click="openTopUp()"
                    class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700"
                    x-text="BILLING_I18N.topupCta"
                ></button>
            </div>
            <p class="mt-2 text-xs text-slate-400">{{ 'pricing.topup.telegram_only'|trans }}</p>
        </section>
    </main>

    {% include 'partials/_billing_topup_modal.html.twig' %}
</div>

{% include 'partials/_billing_topup_script.html.twig' %}
<script>
    function pricingApp() {
        return Object.assign({
            auth: { token: null },
            loggedIn: false,
            quota: {
                plan: null,
                tiers: null,
                maxUploadBytes: 0,
                balanceCents: 0,
                payPerUseCents: 0,
                payPerUseAiCents: 0,
                loaded: false,
            },

            init() {
                this.tryRefresh().then(async (ok) => {
                    if (ok) {
                        await this.refreshTelegramLinkFlag();
                        this.loggedIn = true;
                    }
                    await this.loadQuota();
                });
                window.addEventListener('focus', () => this.onBillingWindowFocus());
            },

            async loadQuota() {
                try {
                    const res = await this.authFetch('/api/v1/quota');
                    if (!res.ok) return;
                    const d = await res.json();
                    this.quota = {
                        plan: d.plan,
                        tiers: d.tiers,
                        maxUploadBytes: d.max_upload_bytes,
                        balanceCents: d.balance_cents ?? 0,
                        payPerUseCents: d.pay_per_use_cents ?? 0,
                        payPerUseAiCents: d.pay_per_use_ai_cents ?? 0,
                        loaded: true,
                    };
                } catch (e) { /* ignore */ }
            },

            async authFetch(url, opts = {}) {
                const withAuth = (o) => {
                    const headers = { ...(o.headers || {}) };
                    if (this.auth.token) headers['Authorization'] = 'Bearer ' + this.auth.token;
                    return { ...o, headers, credentials: 'include' };
                };
                const hadToken = !!this.auth.token;
                let res = await fetch(url, withAuth(opts));
                if (res.status !== 401 || !hadToken) return res;
                const refreshed = await this.tryRefresh();
                if (!refreshed) return res;
                return fetch(url, withAuth(opts));
            },

            async tryRefresh() {
                try {
                    const { ok, token } = await window.sharedAuthRefresh();
                    if (!ok || !token) return false;
                    this.auth.token = token;
                    localStorage.setItem('jwt', token);
                    return true;
                } catch (e) {
                    return false;
                }
            },
        }, billingTopUpMixin());
    }
</script>
{% endblock %}
