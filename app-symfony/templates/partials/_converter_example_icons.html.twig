{# home-10: набор статичных inline-SVG иконок файла по типу — переиспользуется
   для source- и result-иконок карточки примера (_converter_examples.html.twig).
   Разметка каждой иконки полностью статична и авторская (никакой байт файла/
   URL/имени сюда не подставляется) — иконка выбирается ТОЛЬКО через x-if
   сравнение с фиксированной строкой-ключом (см. exampleIconKey()/
   sourceIconKey()/resultIconKey() в _converter_app_script.html.twig), поэтому
   XSS здесь в принципе невозможен — тот же принцип, что и у вьюеров (home-05):
   динамические данные примера НИКОГДА не рендерятся как разметка (ни
   innerHTML, ни x-html).

   macro.icon(keyExpr) — keyExpr это ИМЯ JS-выражения (строка вида
   'sourceIconKey(ex)'), подставляется как есть в атрибут x-if каждого
   <template> ниже. Вызывающая сторона передаёт РАЗНОЕ выражение для
   исходника/результата, макрос переиспользует один и тот же набор иконок.
#}
{% macro icon(keyExpr) %}
    <template x-if="{{ keyExpr }} === 'pdf'">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 2.5h8l4 4V21a.5.5 0 01-.5.5h-11A.5.5 0 016 21V2.5z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 2.5V6a1 1 0 001 1h3.5" />
            <text x="7.2" y="17" font-size="6" fill="currentColor" stroke="none" font-family="sans-serif" font-weight="700">PDF</text>
        </svg>
    </template>
    <template x-if="{{ keyExpr }} === 'image'">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <circle cx="9" cy="10" r="1.7" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 17l5-5 3 3 3.5-3.5L21 16" />
        </svg>
    </template>
    <template x-if="{{ keyExpr }} === 'audio'">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17V6l10-2v11" />
            <circle cx="6.5" cy="17.5" r="2.5" />
            <circle cx="16.5" cy="15.5" r="2.5" />
        </svg>
    </template>
    <template x-if="{{ keyExpr }} === 'video'">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="3" y="5" width="14" height="14" rx="2" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 9.5l4-2.5v10l-4-2.5" />
        </svg>
    </template>
    <template x-if="{{ keyExpr }} === 'json'">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 2.5h8l4 4V21a.5.5 0 01-.5.5h-11A.5.5 0 016 21V2.5z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 2.5V6a1 1 0 001 1h3.5" />
            <text x="7" y="17" font-size="6" fill="currentColor" stroke="none" font-family="sans-serif" font-weight="700">{ }</text>
        </svg>
    </template>
    <template x-if="{{ keyExpr }} === 'csv'">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="1.5" />
            <path stroke-linecap="round" d="M3 9.5h18M3 14.5h18M9 4v16M15 4v16" />
        </svg>
    </template>
    <template x-if="{{ keyExpr }} === 'text'">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 2.5h8l4 4V21a.5.5 0 01-.5.5h-11A.5.5 0 016 21V2.5z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 2.5V6a1 1 0 001 1h3.5" />
            <path stroke-linecap="round" d="M8.5 12.5h7M8.5 15.5h7M8.5 9.5h4" />
        </svg>
    </template>
    <template x-if="{{ keyExpr }} === 'document'">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 2.5h8l4 4V21a.5.5 0 01-.5.5h-11A.5.5 0 016 21V2.5z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 2.5V6a1 1 0 001 1h3.5" />
        </svg>
    </template>
    <template x-if="{{ keyExpr }} === 'data'">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <ellipse cx="12" cy="5.5" rx="8" ry="3" />
            <path stroke-linecap="round" d="M4 5.5V18.5c0 1.66 3.58 3 8 3s8-1.34 8-3V5.5" />
            <path stroke-linecap="round" d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3" />
        </svg>
    </template>
    <template x-if="{{ keyExpr }} === 'generic'">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 2.5h8l4 4V21a.5.5 0 01-.5.5h-11A.5.5 0 016 21V2.5z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 2.5V6a1 1 0 001 1h3.5" />
            <path stroke-linecap="round" d="M9 12.5h6M9 15.5h6" />
        </svg>
    </template>
{% endmacro %}
