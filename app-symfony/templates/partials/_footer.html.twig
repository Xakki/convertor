{# Общий футер (home-01-header-nav): бренд+тэглайн, продукт-ссылка, форматы
   (справочно, не ссылки), легал-ссылки, бот-ссылка, копирайт.
   Визуальный референс — app-front/components/footer.html (НЕ раздаётся, чужой
   стек). Легал-ссылки ведут на `/privacy` и `/terms` (home-06-legal-docs). #}
<footer class="border-t border-slate-200 bg-white py-10">
    <div class="mx-auto max-w-5xl px-4">
        <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
            <div class="col-span-2 md:col-span-1">
                <a href="{{ path('app_home') }}" class="flex items-center gap-2 text-base font-semibold text-slate-800">
                    <span class="text-xl">⚫️</span>
                    <span>{{ 'common.brand'|trans }}</span>
                </a>
                <p class="mt-3 text-sm text-slate-500">{{ 'footer.tagline'|trans }}</p>
            </div>

            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">{{ 'footer.product_heading'|trans }}</h3>
                <ul class="mt-4 space-y-2">
                    <li><a href="{{ path('app_home') }}" class="text-sm text-slate-500 hover:text-slate-800">{{ 'footer.conversion_link'|trans }}</a></li>
                    <li><a href="/SKILL.md" class="text-sm text-slate-500 hover:text-slate-800" data-testid="footer-api-skill-link">{{ 'footer.api_skill_link'|trans }}</a></li>
                </ul>
            </div>

            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">{{ 'footer.formats_heading'|trans }}</h3>
                <ul class="mt-4 space-y-2">
                    <li><span class="text-sm text-slate-500">{{ 'footer.formats_documents'|trans }}</span></li>
                    <li><span class="text-sm text-slate-500">{{ 'footer.formats_media'|trans }}</span></li>
                    <li><span class="text-sm text-slate-500">{{ 'footer.formats_images'|trans }}</span></li>
                    <li><span class="text-sm text-slate-500">{{ 'footer.formats_data'|trans }}</span></li>
                </ul>
            </div>

            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">{{ 'footer.legal_heading'|trans }}</h3>
                <ul class="mt-4 space-y-2">
                    <li><a href="{{ path('app_legal_privacy') }}" class="text-sm text-slate-500 hover:text-slate-800" data-testid="footer-privacy-link">{{ 'footer.privacy'|trans }}</a></li>
                    <li><a href="{{ path('app_legal_terms') }}" class="text-sm text-slate-500 hover:text-slate-800" data-testid="footer-terms-link">{{ 'footer.terms'|trans }}</a></li>
                </ul>
            </div>
        </div>

        <div class="mt-8 flex flex-col items-center justify-between gap-4 border-t border-slate-200 pt-6 sm:flex-row">
            <p class="text-sm text-slate-400">&copy; {{ "now"|date("Y") }} {{ 'common.brand'|trans }}. {{ 'footer.copyright'|trans }}</p>
            <a
                href="https://t.me/{{ telegram_bot_username }}"
                target="_blank"
                rel="noopener"
                class="text-slate-400 hover:text-slate-800"
                aria-label="{{ 'nav.bot'|trans }}"
            >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
                </svg>
            </a>
        </div>
    </div>
</footer>
