{# Общий хедер (home-01-header-nav): бренд, переключатель языка (перенесён
   сюда с `/`/`/login`, см. комментарий в partials/_locale_switcher.html.twig),
   навигация Docs/Bot/Admin(только ROLE_ADMIN)/Conversions(dropdown, home-09),
   блок входа/профиля. Подключается из base.html.twig — общий для всех страниц
   на этом layout.

   Auth-состояние ЦЕЛИКОМ клиентское (Alpine `headerNav()`), НЕ Twig
   `app.user`/`is_granted()`: firewall `main` (config/packages/security.yaml)
   не имеет ни одного authenticator'а — сервер не проверяет refresh-cookie на
   обычном GET, поэтому `is_granted()` в Twig на `/` и `/login` ВСЕГДА
   anonymous, буквальный серверный гейт здесь технически невозможен. Тот же
   паттерн уже принят для `/admin` (см. templates/admin/base.html.twig —
   "Option B": открытая оболочка + клиентский guard, единственная реальная
   граница безопасности — API `^/api/v1/admin`, ROLE_ADMIN). Здесь так же:
   POST /api/v1/auth/refresh (httpOnly refresh-cookie) → при наличии токена
   GET /api/v1/me (id/name/avatar_url/profile_url/is_admin — is_admin уже
   готов с сервера, JWT-роли вручную не декодируем). Admin-пункт —
   `<template x-if="isAdmin">`: узел ОТСУТСТВУЕТ в DOM, пока isAdmin не
   подтверждён, а не просто держится под display:none. #}
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur-sm" x-data="headerNav()" x-init="init()">
    <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4">
        <a href="{{ path('app_home') }}" class="flex shrink-0 items-center gap-2 text-lg font-semibold text-slate-800">
            <span class="text-2xl">⚫️</span>
            <span>{{ 'common.brand'|trans }}</span>
        </a>

        <nav class="hidden items-center gap-5 md:flex" aria-label="{{ 'nav.aria_label'|trans }}">
            {# home-09-seo-conversion-pages: рабочий дропдаун — курируемый
               подсписок пар (App\Service\Conversion\CuratedConversionPairs,
               прокинут через Twig-функцию curated_conversion_pairs(), см.
               App\Twig\ConversionExtension), сгруппированный по категории,
               НЕ полная матрица форматов. Свой локальный x-data — вложенная
               Alpine-область внутри headerNav(), независимая от auth-состояния. #}
            <div
                class="relative"
                x-data="{ open: false }"
                @keydown.escape.window="open = false"
                @click.outside="open = false"
            >
                <button
                    type="button"
                    @click="open = !open"
                    class="flex items-center gap-1 text-sm text-slate-600 hover:text-slate-900"
                    data-testid="nav-conversions"
                    :aria-expanded="open.toString()"
                >
                    {{ 'nav.conversions'|trans }}
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/>
                    </svg>
                </button>
                <div
                    x-show="open"
                    x-cloak
                    x-transition
                    class="absolute left-0 top-full z-50 mt-2 w-64 rounded-lg border border-slate-200 bg-white p-3 shadow-lg"
                    data-testid="nav-conversions-menu"
                >
                    {% for category, pairs in curated_conversion_pairs() %}
                        <div class="mb-3 last:mb-0">
                            <p class="px-2 text-xs font-semibold uppercase tracking-wide text-slate-400">{{ ('home.category.' ~ category)|trans }}</p>
                            <ul class="mt-1">
                                {% for pair in pairs %}
                                    <li>
                                        <a
                                            href="{{ path('app_conversion_pair', {pair: pair.from ~ '-to-' ~ pair.to}) }}"
                                            class="block rounded px-2 py-1 text-sm text-slate-600 hover:bg-indigo-50 hover:text-indigo-700"
                                            @click="open = false"
                                        >{{ pair.from|upper }} → {{ pair.to|upper }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <a href="/api/doc" class="text-sm text-slate-600 hover:text-slate-900">{{ 'nav.docs'|trans }}</a>
            <a
                href="https://t.me/{{ telegram_bot_username }}"
                target="_blank"
                rel="noopener"
                class="text-sm text-slate-600 hover:text-slate-900"
            >{{ 'nav.bot'|trans }}</a>
            <template x-if="isAdmin">
                <a href="/admin" class="text-sm text-slate-600 hover:text-slate-900">{{ 'nav.admin'|trans }}</a>
            </template>
        </nav>

        <div class="flex items-center gap-4">
            {% include 'partials/_locale_switcher.html.twig' %}

            <div x-cloak x-show="!loggedIn">
                <a
                    href="/login"
                    class="rounded bg-sky-500 px-4 py-1.5 text-sm font-medium text-white hover:bg-sky-600"
                >{{ 'nav.login'|trans }}</a>
            </div>
            <div x-cloak x-show="loggedIn" class="flex items-center gap-3 text-sm">
                {# Чип профиля: аватар + имя. При profile_url — весь чип ссылка
                   (:href на null отбрасывает атрибут → инертный текст). #}
                <a
                    :href="user.profile_url"
                    :target="user.profile_url ? '_blank' : null"
                    rel="noopener"
                    class="flex items-center gap-2 text-slate-600"
                >
                    <template x-if="user.avatar_url">
                        <img :src="user.avatar_url" alt="" class="h-7 w-7 rounded-full object-cover">
                    </template>
                    <template x-if="!user.avatar_url">
                        <span
                            class="flex h-7 w-7 items-center justify-center rounded-full bg-slate-200 text-xs font-medium text-slate-600"
                            x-text="avatarInitial()"
                        ></span>
                    </template>
                    <span class="hidden sm:inline" x-text="user.name || '{{ 'common.you_are_logged_in'|trans|e('js') }}'"></span>
                </a>
                <button
                    @click="logout()"
                    class="rounded border border-slate-300 px-3 py-1 text-slate-600 hover:bg-slate-100"
                >{{ 'common.logout'|trans }}</button>
            </div>
        </div>
    </div>
</header>

<script>
    function headerNav() {
        return {
            loggedIn: false,
            isAdmin: false,
            user: { name: null, avatar_url: null, profile_url: null },

            // Клиентский auth-guard (см. комментарий над <header>): тихий silent-
            // refresh по httpOnly refresh-cookie + /api/v1/me. Гость/аноним — 401
            // на любом из шагов, тихо остаёмся в состоянии "не вошёл".
            async init() {
                try {
                    const res = await fetch('/api/v1/auth/refresh', { method: 'POST', credentials: 'include' });
                    if (!res.ok) return;
                    const d = await res.json();
                    if (!d.token) return;
                    const meRes = await fetch('/api/v1/me', {
                        headers: { Authorization: 'Bearer ' + d.token },
                        credentials: 'include',
                    });
                    if (!meRes.ok) return;
                    const me = await meRes.json();
                    this.user = { name: me.name, avatar_url: me.avatar_url, profile_url: me.profile_url };
                    this.isAdmin = me.is_admin === true;
                    this.loggedIn = true;
                } catch (e) { /* сеть моргнула — остаёмся в состоянии "не вошёл" */ }
            },

            avatarInitial() {
                return (this.user.name || '?').trim().charAt(0).toUpperCase();
            },

            // Полный переход на "/" вместо локального сброса состояния: у хедера
            // и других Alpine-компонентов страницы (например converterApp() на
            // `/`) — независимые копии auth-состояния (история/скачивания). Реальная
            // перезагрузка переинициализирует их все с нуля вместо ручной
            // рассинхронизированной синхронизации нескольких компонентов.
            logout() {
                fetch('/api/v1/auth/logout', { method: 'POST', credentials: 'include' })
                    .catch(() => {})
                    .finally(() => { window.location.href = '/'; });
            },
        };
    }
</script>
