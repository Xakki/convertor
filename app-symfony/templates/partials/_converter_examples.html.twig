{# ── home-04 (Part B): живые примеры конвертаций из S3 ──
   Вынесено из conversion/index.html.twig в partial home-09-seo-conversion-pages
   — переиспользуется conversion/pair.html.twig БЕЗ изменений разметки: на
   странице пары converterApp({lockedFrom,lockedTo,lockedCategory}) фильтрует
   `examples` до пары/категории ДО того, как этот шаблон их рендерит (см.
   _converter_app_script.html.twig → init()), так что здесь ничего решать не
   надо — `examples` уже содержит нужный (под)список.

   Данные — из GET /api/v1/examples (публичный, без логина). Каждая карточка
   несёт data-category / data-to-format / data-example-url — контракт для
   home-05-file-viewers: вьюер найдёт карточки по этим атрибутам и навесит
   превью без переделки разметки.

   home-10: вместо трёх текстовых кнопок (Просмотр/Скачать/превью-по-типу) —
   ДВЕ кликабельные иконки файла (исходник ex.source_url + результат ex.url).
   Клик = превью (previewable-форматы, через существующие openViewer/
   togglePlayer/openPreviewFromUrl) либо скачивание (downloadPublicUrl) —
   решает clickExampleIcon() в _converter_app_script.html.twig. Иконки —
   статичный inline-SVG (см. _converter_example_icons.html.twig), выбор ТОЛЬКО
   по x-if сравнению с ключом формата — байты файла в разметку не попадают. #}
{% import 'partials/_converter_example_icons.html.twig' as icons %}
<template x-if="examples.length > 0">
    <section class="mt-10" id="examples">
        <h2 class="text-lg font-semibold text-slate-800">{{ 'home.examples.heading'|trans }}</h2>
        <p class="mt-1 text-sm text-slate-500">{{ 'home.examples.subheading'|trans }}</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <template x-for="ex in examples" :key="ex.category + '-' + ex.filename">
                <div
                    class="flex flex-col rounded-lg border border-slate-200 bg-white p-4 shadow-sm"
                    :data-category="ex.category"
                    :data-to-format="ex.to"
                    :data-example-url="ex.url"
                >
                    <div class="flex items-center justify-between gap-2">
                        <h3 class="text-sm font-semibold text-slate-700" x-text="I18N.showcase.category[ex.category] || ex.category"></h3>
                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">
                            <span x-text="ex.from"></span>
                            <span class="text-slate-400"> → </span>
                            <span x-text="ex.to"></span>
                        </span>
                    </div>
                    <p x-show="ex.size > 0" class="mt-1 text-xs text-slate-400" x-text="humanSize(ex.size)"></p>

                    {# home-10: две кликабельные иконки файла — исходник (ex.source_url)
                       и результат (ex.url). Клик решает clickExampleIcon() в
                       _converter_app_script.html.twig: previewable-формат → превью
                       (openViewer/togglePlayer/openPreviewFromUrl, isPublic=true — оба
                       URL публичные inline-эндпоинты ExampleController), иначе —
                       скачивание (downloadPublicUrl). Иконки сами — статичный
                       inline-SVG из _converter_example_icons.html.twig. #}
                    <div class="mt-3 flex items-center justify-center gap-3">
                        <button
                            type="button"
                            @click="clickExampleIcon(ex, 'source')"
                            class="flex flex-col items-center gap-1 rounded-lg border border-slate-200 px-3 py-2 text-slate-500 transition hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-600"
                            :aria-label="ex.from"
                        >
                            {{ icons.icon('sourceIconKey(ex)') }}
                            <span class="text-[11px] font-medium uppercase tracking-wide" x-text="ex.from"></span>
                        </button>
                        <span class="text-slate-300" aria-hidden="true">→</span>
                        <button
                            type="button"
                            @click="clickExampleIcon(ex, 'result')"
                            class="flex flex-col items-center gap-1 rounded-lg border border-slate-200 px-3 py-2 text-slate-500 transition hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-600"
                            :aria-label="ex.to"
                        >
                            {{ icons.icon('resultIconKey(ex)') }}
                            <span class="text-[11px] font-medium uppercase tracking-wide" x-text="ex.to"></span>
                        </button>
                    </div>

                    {# home-05/home-10: инлайн-плеер audio/video — исходник и результат
                       независимы (ключ включает side), могут быть открыты одновременно. #}
                    <template x-if="players[examplePlayerKey(ex, 'source')]?.objectUrl && exampleSourceViewerType(ex) === 'audio'">
                        {# object URL/публичный URL — источник для <audio>, НЕ HTML-контент. #}
                        <audio :src="players[examplePlayerKey(ex, 'source')].objectUrl" controls class="mt-2 w-full"></audio>
                    </template>
                    <template x-if="players[examplePlayerKey(ex, 'source')]?.objectUrl && exampleSourceViewerType(ex) === 'video'">
                        {# object URL/публичный URL — источник для <video>, НЕ HTML-контент. #}
                        <video :src="players[examplePlayerKey(ex, 'source')].objectUrl" controls class="mt-2 max-h-96 w-full"></video>
                    </template>
                    <template x-if="players[examplePlayerKey(ex, 'result')]?.objectUrl && exampleViewerType(ex) === 'audio'">
                        {# object URL/публичный URL — источник для <audio>, НЕ HTML-контент. #}
                        <audio :src="players[examplePlayerKey(ex, 'result')].objectUrl" controls class="mt-2 w-full"></audio>
                    </template>
                    <template x-if="players[examplePlayerKey(ex, 'result')]?.objectUrl && exampleViewerType(ex) === 'video'">
                        {# object URL/публичный URL — источник для <video>, НЕ HTML-контент. #}
                        <video :src="players[examplePlayerKey(ex, 'result')].objectUrl" controls class="mt-2 max-h-96 w-full"></video>
                    </template>
                </div>
            </template>
        </div>
    </section>
</template>
