{# ── CNV-61-preview: кликабельная иконка файла (source/result) — общий
   макрос для истории (/history), только что завершённой job (`/`,
   /convert/{pair}) и лога конвертаций админки (/admin/logs). Иконка сама —
   статичный inline-SVG из _converter_example_icons.html.twig (см. её шапку —
   выбор ТОЛЬКО по x-if сравнению с ключом, байты файла в разметку не
   попадают); клик вызывает clickExpr — ожидается вызов openFilePreview()
   (через обёртку компонента, см. historyPreviewIcon()/jobPreviewIcon()/
   adminPreviewIcon() в соответствующих *_script.html.twig).

   iconMarkup — УЖЕ отрендеренная разметка macro icon() (Twig-макросы не
   видят импорты другого файла изнутри своего тела — cross-file macro-in-macro
   не резолвится, "getTemplateForMacro() on null"), поэтому вызывающая
   сторона импортирует _converter_example_icons.html.twig САМА и передаёт
   `icons.icon(iconKeyExpr)` первым аргументом (см. использование ниже).

   variant: 'light' (home/history, светлые карточки) | 'dark' (admin, тёмная
   тема) — только цвет рамки/hover, форма идентична. #}
{% macro button(iconMarkup, clickExpr, labelExpr, variant) %}
    {% set variant = variant|default('light') %}
    <button
        type="button"
        @click="{{ clickExpr }}"
        class="inline-flex shrink-0 items-center justify-center rounded-lg border p-1.5 transition {{ variant == 'dark' ? 'border-zinc-700 text-zinc-400 hover:border-indigo-500/50 hover:bg-zinc-800 hover:text-indigo-300' : 'border-slate-200 text-slate-500 hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-600' }}"
        :aria-label="{{ labelExpr }}"
    >
        {{ iconMarkup }}
    </button>
{% endmacro %}
