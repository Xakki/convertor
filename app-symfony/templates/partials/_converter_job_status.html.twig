{# ── Статус задачи и результат (converterApp()) ──
   Вынесено из conversion/index.html.twig в partial home-09-seo-conversion-pages,
   чтобы templates/conversion/pair.html.twig переиспользовал ТОТ ЖЕ рендер
   один-в-один (не форк разметки) — работает и там, и там, т.к. читает только
   реактивное состояние Alpine-компонента converterApp() (job/filePreview),
   доступное из x-data-области родителя (см. include-точки).

   CNV-61-preview: источник/результат превьюются иконками (jobSourceIconKey()/
   jobResultIconKey()/jobPreviewIcon(), _converter_app_script.html.twig) через
   ту же общую модалку filePreview, что и /history — см.
   _file_preview_icon_button.html.twig / _file_preview_modal.html.twig
   (последний ДОЛЖЕН быть заинклюжен в родительском шаблоне ВНУТРИ x-data,
   как и остальные модалки). #}
{% import 'partials/_file_preview_icon_button.html.twig' as fpBtn %}
{% import 'partials/_converter_example_icons.html.twig' as fpIcons %}
<template x-if="job.id">
    <div class="mt-6 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
            <span class="text-sm text-slate-500">{{ 'home.job_prefix'|trans }}<span x-text="job.id"></span></span>
            <span
                class="rounded-full px-3 py-1 text-xs font-medium"
                :class="{
                    'bg-slate-100 text-slate-600': isActive(job.status) || job.status === 'poll_gave_up',
                    'bg-green-100 text-green-700': job.status === 'completed',
                    'bg-red-100 text-red-700': isFailed(job.status),
                }"
                x-text="statusLabel(job.status)"
            ></span>
        </div>

        <template x-if="isActive(job.status)">
            <div class="mt-4 flex items-center gap-2 text-sm text-slate-500">
                <svg class="h-4 w-4 animate-spin text-indigo-500" viewBox="0 0 24 24" fill="none">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.4 0 0 5.4 0 12h4z"></path>
                </svg>
                {{ 'home.job_processing'|trans }}
            </div>
        </template>

        {# CNV-71-03: клиентский поллинг сдался через ~5 минут (POLL_GAVE_UP_STATUS,
           _converter_app_script.html.twig) — задача НЕ failed/expired на сервере,
           просто ждёт воркера дольше, чем мы готовы крутить спиннер. Нейтральная
           (НЕ красная) подача, download-кнопка скрыта (условие ниже завязано
           строго на 'completed'), ссылка на /history — тем же путём/копией, что
           и постоянная ссылка формы (home.history_link / app_history). #}
        <template x-if="job.status === 'poll_gave_up'">
            <div class="mt-4 rounded-lg bg-slate-50 px-4 py-3 text-sm text-slate-600">
                <p>{{ 'home.poll_gave_up_message'|trans }}</p>
                <a
                    href="{{ path('app_history') }}"
                    class="mt-2 inline-block font-medium text-indigo-600 hover:text-indigo-700 hover:underline"
                >{{ 'home.history_link'|trans }}</a>
            </div>
        </template>

        <template x-if="job.status === 'completed'">
            <div class="mt-4">
                {# Скачивание доступно и гостю: он владеет своей конвертацией
                   через guest-cookie (fetch+blob с credentials:'include'). #}
                <button
                    @click="download()"
                    :disabled="downloading"
                    class="inline-flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700 disabled:bg-slate-300"
                >
                    <span x-show="!downloading">{{ 'home.download_result'|trans }}</span>
                    <span x-show="downloading" x-cloak>{{ 'common.loading'|trans }}</span>
                </button>

                {# CNV-61-preview: иконки-превью источника/результата — тот же
                   паттерн, что и на /history (см. _conversion_history.html.twig),
                   единая модалка (filePreviewMixin(), _file_preview_modal.html.twig)
                   вместо разных виджетов на image/pdf/audio/video. #}
                <div class="mt-3 flex items-center gap-2">
                    {{ fpBtn.button(fpIcons.icon('jobSourceIconKey()'), "jobPreviewIcon('source')", 'FILE_PREVIEW_I18N.sourceLabel') }}
                    {{ fpBtn.button(fpIcons.icon('jobResultIconKey()'), "jobPreviewIcon('result')", 'FILE_PREVIEW_I18N.resultLabel') }}
                </div>
            </div>
        </template>

        {# CNV-71-03: для 'expired' ВСЕГДА показываем локальный (авторский)
           текст, а не job.error — серверный errorMessage для этого статуса
           фиксированная строка без упоминания возврата оплаты
           (ConversionResultPersister::persist()), а AC требует явно сказать
           про возврат. Для 'failed' порядок не меняем — там job.error несёт
           реальную, разную по конверсиям причину отказа. #}
        <template x-if="isFailed(job.status)">
            <div class="mt-4 text-sm text-red-600" x-text="job.status === 'expired' ? '{{ 'home.error_expired'|trans|e('js') }}' : (job.error || '{{ 'home.error_failed'|trans|e('js') }}')"></div>
        </template>
    </div>
</template>
