{# ── Статус задачи и результат (converterApp()) ──
   Вынесено из conversion/index.html.twig в partial home-09-seo-conversion-pages,
   чтобы templates/conversion/pair.html.twig переиспользовал ТОТ ЖЕ рендер
   один-в-один (не форк разметки) — работает и там, и там, т.к. читает только
   реактивное состояние Alpine-компонента converterApp() (job/jobViewerType/
   players), доступное из x-data-области родителя (см. include-точки). #}
<template x-if="job.id">
    <div class="mt-6 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
            <span class="text-sm text-slate-500">{{ 'home.job_prefix'|trans }}<span x-text="job.id"></span></span>
            <span
                class="rounded-full px-3 py-1 text-xs font-medium"
                :class="{
                    'bg-slate-100 text-slate-600': isActive(job.status),
                    'bg-green-100 text-green-700': job.status === 'completed',
                    'bg-red-100 text-red-700': isFailed(job.status),
                }"
                x-text="statusLabel(job.status)"
            ></span>
        </div>

        <template x-if="isActive(job.status)">
            <div class="mt-4 flex items-center gap-2 text-sm text-slate-500">
                <svg class="h-4 w-4 animate-spin text-indigo-500" viewBox="0 0 24 24" fill="none">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.4 0 0 5.4 0 12h4z"></path>
                </svg>
                {{ 'home.job_processing'|trans }}
            </div>
        </template>

        <template x-if="job.status === 'completed'">
            <div class="mt-4">
                {# Скачивание доступно и гостю: он владеет своей конвертацией
                   через guest-cookie (fetch+blob с credentials:'include'). #}
                <button
                    @click="download()"
                    :disabled="downloading"
                    class="inline-flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700 disabled:bg-slate-300"
                >
                    <span x-show="!downloading">{{ 'home.download_result'|trans }}</span>
                    <span x-show="downloading" x-cloak>{{ 'common.loading'|trans }}</span>
                </button>

                {# home-05: инлайн-вьюер результата — тип вьюера зависит от
                   целевого формата/категории (jobViewerType, D4 LIGHT MVP).
                   Текстовый превью (jobViewerType === 'text') намеренно НЕ
                   дублируется тут отдельной кнопкой — та же задача появляется
                   в истории сразу после завершения (loadHistory() в poll()),
                   где уже есть кнопка «Просмотр» через существующий openPreview(). #}
                <template x-if="jobViewerType === 'image' || jobViewerType === 'pdf'">
                    <div class="mt-3">
                        <button
                            @click="openViewer(jobViewerType, '/api/v1/convert/' + job.id + '/download', false)"
                            class="rounded-lg border border-indigo-300 px-3 py-1.5 text-xs font-medium text-indigo-600 hover:bg-indigo-50"
                        >{{ 'home.history_preview'|trans }}</button>
                    </div>
                </template>
                <template x-if="jobViewerType === 'audio' || jobViewerType === 'video'">
                    <div class="mt-3">
                        <button
                            @click="togglePlayer('job', jobViewerType, '/api/v1/convert/' + job.id + '/download', false)"
                            class="rounded-lg border border-indigo-300 px-3 py-1.5 text-xs font-medium text-indigo-600 hover:bg-indigo-50"
                        >
                            <span x-text="players['job'] ? I18N.viewer.hidePlayer : I18N.viewer.showPlayer"></span>
                        </button>
                        <template x-if="players['job']?.loading">
                            <p class="mt-2 text-xs text-slate-400">{{ 'common.loading'|trans }}</p>
                        </template>
                        <template x-if="players['job']?.error">
                            <p class="mt-2 text-xs text-red-600" x-text="players['job'].error"></p>
                        </template>
                        <template x-if="players['job']?.objectUrl && jobViewerType === 'audio'">
                            {# object URL — источник для <audio>, браузер декодирует
                               как аудиопоток, НЕ как HTML/скрипт. #}
                            <audio :src="players['job'].objectUrl" controls class="mt-2 w-full"></audio>
                        </template>
                        <template x-if="players['job']?.objectUrl && jobViewerType === 'video'">
                            {# object URL — источник для <video>, браузер декодирует
                               как видеопоток, НЕ как HTML/скрипт. #}
                            <video :src="players['job'].objectUrl" controls class="mt-2 max-h-96 w-full"></video>
                        </template>
                    </div>
                </template>
            </div>
        </template>

        <template x-if="isFailed(job.status)">
            <div class="mt-4 text-sm text-red-600" x-text="job.error || (job.status === 'expired' ? '{{ 'home.error_expired'|trans|e('js') }}' : '{{ 'home.error_failed'|trans|e('js') }}')"></div>
        </template>
    </div>
</template>
