{# ── Модалка предпросмотра результата (одна на страницу) ──
   Вынесено из conversion/index.html.twig в partial home-09-seo-conversion-pages
   — переиспользуется conversion/pair.html.twig один-в-один. ВАЖНО: этот
   include должен остаться ВНУТРИ x-data="converterApp(...)" (см. родительский
   шаблон) — читает preview.* реактивного состояния компонента.
   Текст рендерится ТОЛЬКО через x-text (untrusted content, без x-html). #}
<div
    x-show="preview.open"
    x-cloak
    @keydown.escape.window="closePreview()"
    class="fixed inset-0 z-50 flex items-center justify-center p-4"
>
    {# Бэкдроп: клик мимо — закрыть #}
    <div class="absolute inset-0 bg-slate-900/50" @click="closePreview()"></div>
    <div class="relative flex max-h-[85vh] w-full max-w-2xl flex-col rounded-lg bg-white shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
            <h3 class="text-sm font-semibold text-slate-700">{{ 'home.preview_title'|trans }}</h3>
            <button
                @click="closePreview()"
                class="rounded p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-600"
                aria-label="{{ 'common.close'|trans }}"
            >✕</button>
        </div>

        <template x-if="preview.truncated">
            <div class="border-b border-amber-200 bg-amber-50 px-4 py-2 text-xs text-amber-800">
                {{ 'home.preview_truncated'|trans }}
            </div>
        </template>

        <div class="min-h-0 flex-1 overflow-auto p-4">
            <template x-if="preview.loading">
                <p class="text-sm text-slate-500">{{ 'common.loading'|trans }}</p>
            </template>
            <template x-if="!preview.loading">
                <pre class="whitespace-pre-wrap break-words font-mono text-xs text-slate-700" x-text="preview.text"></pre>
            </template>
        </div>

        <div class="flex justify-end gap-2 border-t border-slate-200 px-4 py-3">
            {# home-05: у примера (preview.id === null, открыт через openPreviewFromUrl())
               уже есть отдельная кнопка «Скачать» в карточке примера — тут её прячем,
               чтобы не показывать неактивный (no-op) «Скачать». #}
            <button
                x-show="preview.id !== null"
                @click="downloadPreview()"
                class="rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700"
            >{{ 'common.download'|trans }}</button>
            <button
                @click="closePreview()"
                class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100"
            >{{ 'common.close'|trans }}</button>
        </div>
    </div>
</div>
