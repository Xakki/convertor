###> symfony/framework-bundle ###
APP_SECRET=change_me_to_random_32_chars_string
# Публичный базовый URL приложения. Используется для magic-ссылки Telegram-логина
# (webhook шлёт <APP_URL>/api/v1/auth/telegram/callback?code=...). Переопределяется
# из корневого .env / .env.local. Без завершающего слэша.
APP_URL=https://convertor.xakki.pro
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# MariaDB 11 — adjust host/port/dbname as needed
DATABASE_URL="mysql://convertor:123456@mariadb:3306/convertor?serverVersion=10.11.2-MariaDB&charset=utf8mb4"  # dev default; if DB password changes, override via app-symfony/.env.local
###< doctrine/doctrine-bundle ###

###> Cache pool (cache.app) ###
# Общий Redis-кэш на KeyDB, БД 0 (cache=0, sessions=1, queues=2). Нужен, чтобы
# инвалидация кэша конверторов была видна всем PHP-инстансам (см. cache.yaml).
# Пароля нет — KeyDB с `protected-mode no` и без `requirepass`. Если requirepass
# когда-либо добавят: redis://default:${REDIS_PASSWORD}@keydb:6379?dbindex=0
REDIS_CACHE_DSN=redis://keydb:6379?dbindex=0
###< Cache pool ###

###> symfony/messenger ###
# Queue DB = 2 (cache=0, sessions=1, queues=2). For the Messenger Redis-Streams
# transport the db is set via the `dbindex` query param — the DSN *path* is
# stream/group/consumer, NOT the db. Workers must read REDIS_DB=2 (compose).
# KeyDB runs with `protected-mode no` and no `requirepass` → no password in DSN
# (an empty REDIS_PASSWORD must never produce a broken `default:@` auth prefix).
# If requirepass is ever added: redis://default:${REDIS_PASSWORD}@keydb:6379?dbindex=2
REDIS_DSN=redis://keydb:6379?dbindex=2
###< symfony/messenger ###

###> Refresh tokens ###
# Opaque refresh-token families in KeyDB db 1 (sessions). Access JWT stays Lexik.
REDIS_SESSIONS_DSN=redis://keydb:6379?dbindex=1
REFRESH_TTL=2592000
REFRESH_GRACE=60
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=refresh_token
###< Refresh tokens ###

###> Guest cookie (анонимная конвертация) ###
# httpOnly-cookie `guest_id`: TTL 30 дней, Secure (в prod). Подпись HMAC.
# GUEST_COOKIE_SECRET по умолчанию = APP_SECRET (services.yaml) — переопределять
# только если нужна отдельная ротация; тогда реальное значение — в .env.local.
#GUEST_COOKIE_SECRET=
GUEST_COOKIE_SECURE=true
GUEST_COOKIE_TTL=2592000
# Доверенные прокси для getClientIp() (nginx). `private_ranges` = приватные сети.
TRUSTED_PROXIES=private_ranges
###< Guest cookie ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me
###< lexik/jwt-authentication-bundle ###

###> Telegram ###
TELEGRAM_BOT_TOKEN=
# Публичное имя бота (не секрет) для deep-link t.me/<bot>?start=<code>
TELEGRAM_BOT_USERNAME=YouFileConvertBot
# Секрет webhook (заголовок X-Telegram-Bot-Api-Secret-Token). Реальное значение —
# только в .env.local; трекаемый плейсхолдер пустой (fail-closed при пустом).
TELEGRAM_WEBHOOK_SECRET=
###< Telegram ###

###> Worker pull-API ###
# Static bearer token for off-server workers. Set a strong secret in .env.local.
WORKER_API_TOKEN=
# Bearer token for the WS-Gateway internal relay (/api/v1/internal/worker).
# Distinct from WORKER_API_TOKEN. Set a strong secret in .env.local.
GATEWAY_INTERNAL_TOKEN=
# Object-key prefix for S3 result objects (distinct from S3_BUCKET_PREFIX = bucket name prefix).
# Leave empty in prod; set e.g. "dev/" to namespace dev results.
S3_PREFIX=
###< Worker pull-API ###

###> Admin queue monitoring ###
# URL текстового /metrics существующего metrics-exporter (Prometheus-sidecar).
# Symfony скрейпит его для admin-панели очередей по внутренней docker-сети
# `backend` (php ↔ metrics-exporter общий сегмент). Не секрет; дефолт рабочий.
# Symfony-only (читается Dotenv), НЕ инжектится через docker-compose environment.
METRICS_EXPORTER_URL=http://metrics-exporter:9472/metrics
###< Admin queue monitoring ###

###> Admin conversion logs ###
# Базовый URL веб-интерфейса Graylog для линк-аута из admin-панели логов
# (напр. https://graylog.example.com). Пусто = ссылка «открыть в Graylog»
# скрыта. Не секрет; реальное значение — в .env.local прод-стенда.
GRAYLOG_URL=
###< Admin conversion logs ###

###> S3 / MinIO (result sink + download proxy) ###
# Real values come from compose env (.env / .env.local → x-app-env). These are
# only non-compose fallbacks; secrets stay EMPTY in the tracked file.
# Result bucket = {S3_BUCKET_PREFIX}-results.
S3_ENDPOINT=https://apis3.variantgood.com
S3_REGION=us-east-1
S3_KEY=
S3_SECRET=
S3_BUCKET_PREFIX=convertor
S3_USE_PATH_STYLE=true
###< S3 ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###
