# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Публичный URL для magic-ссылки Telegram-логина (детерминированный в тестах).
APP_URL=https://convertor.test

# Refresh tokens: insecure cookie so tests over plain HTTP keep it.
REFRESH_COOKIE_SECURE=false

# Telegram webhook: non-empty secret so webhook tests have a value to compare against.
TELEGRAM_WEBHOOK_SECRET=test-telegram-webhook-secret

# Top-up packs for billing tests (CNV-28).
TOPUP_PACKS_JSON='{"pack_100":{"usd_cents":100,"stars":100},"pack_500":{"usd_cents":500,"stars":450},"pack_2000":{"usd_cents":2000,"stars":1700}}'

# Guest cookie: insecure over plain HTTP так же, как refresh.
GUEST_COOKIE_SECURE=false

# Worker pull-API: non-empty token for functional tests + test-isolated S3 bucket/key prefix.
WORKER_API_TOKEN=test-worker-token
# Distinct token so the cross-auth test proves worker≠internal firewalls.
GATEWAY_INTERNAL_TOKEN=test-internal-token
S3_BUCKET_PREFIX=test_
S3_PREFIX=test_

# e2e: isolate KeyDB to DB 3 (REDIS_DSN is Symfony-only, not injected via Docker env).
REDIS_DSN=redis://keydb:6379?dbindex=3
# Sessions/refresh-token store — тоже на изолированный DB 3, чтобы refresh-token
# и telegram-login-code тесты не текли в общий db1.
REDIS_SESSIONS_DSN=redis://keydb:6379?dbindex=3

# e2e: seed & validate against the isolated test DB (created by docker/mariadb/dev/init/create-test-db.sh).
# Prerequisite: schema must be migrated — run once: DATABASE_URL=<below> bin/console doctrine:migrations:migrate
DATABASE_URL="mysql://convertor-test:123456@mariadb:3306/convertor-test?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
