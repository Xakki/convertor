[mysqld]
port = 3306
bind-address = 0.0.0.0
skip-host-cache
skip-name-resolve
skip-external-locking

# Наблюдаем
# show global status like 'Created_tmp_disk_tables';
#
tmp_table_size              = 100M
max_heap_table_size         = 100M
max_binlog_size             = 200M

max_connections             = 250
max_allowed_packet          = 256M
key_buffer_size             = 100M
innodb_buffer_pool_size     = 2G
innodb_log_file_size        = 500M
innodb_log_buffer_size      = 32M
innodb_file_per_table       = ON
innodb_flush_method         = O_DIRECT
innodb_flush_log_at_trx_commit  = 2
innodb_stats_on_metadata = OFF

# наблюдаем
# show global status like 'Opened_tables';
#
table_open_cache = 2048
thread_cache_size = 32


default_time_zone = 'SYSTEM'
sql_mode = STRICT_TRANS_TABLES,STRICT_ALL_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION,NO_UNSIGNED_SUBTRACTION,PAD_CHAR_TO_FULL_LENGTH

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

log_output=FILE
slow_query_log=1
slow_query_log_file = /var/log/mysql-slow.log
long_query_time=2.0
log_slow_rate_limit=10
log_slow_verbosity=query_plan,innodb
log-queries-not-using-indexes = 1
expire_logs_days            = 7

#server-id=1
#log_bin=/scripts/mariadb-log.bin
skip-log-bin

wait_timeout = 300
interactive_timeout = 600
net_read_timeout = 60

[client]
default-character-set=utf8mb4
