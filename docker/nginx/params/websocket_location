location ^~ /ws/ {
    proxy_pass http://php:10081;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'Upgrade';
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $host;
    # --- Ключевые тайм-ауты ---
    # Самый важный параметр для WebSocket.
    # Если от бэкенда нет данных (даже pong-ответов) дольше 90 секунд,
    # Nginx закроет соединение. Этого времени (3 x 30с) достаточно,
    # чтобы пережить кратковременные сетевые задержки.
    proxy_read_timeout 120;
    # Тайм-аут на установку соединения с бэкендом. 10 секунд более чем достаточно.
    proxy_connect_timeout 10;
    # Тайм-аут на передачу данных бэкенду. 60с - стандарт.
    proxy_send_timeout 120;

    client_max_body_size 5M;

    keepalive_requests 6000;
    client_body_timeout 60;
    keepalive_timeout 60;
}
