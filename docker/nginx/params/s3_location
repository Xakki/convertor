
    # MinIO health probe — должен отвечать 200 без аутентификации.
    # Smoke-тест: curl -I http://s3-profmatrix.xakki.ru/minio/health/live
    location = /s3/live {
        proxy_pass https://apis3.xakki.ru;
        proxy_set_header Host apis3.xakki.ru;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_verify off;  # включить on после проверки CA-доверия к apis3.xakki.ru
        access_log off;
    }

    # Основное проксирование объектов: https://s3-profmatrix.xakki.ru/<bucket>/<key>
    # → /s3/<bucket>/<key> (path-style).
    location /s3 {

        # На случай очень больших объектов (через прокси идут только GET/HEAD,
        # но не ограничиваем заранее — приоритет на отсутствие 413).
        client_max_body_size 32M;
        # Защита от использования фасада как анонимного PUT-relay'я.
        # Авторизованные PUT/DELETE идут напрямую с PHP-клиента на apis3.xakki.ru.
        limit_except GET HEAD OPTIONS {
            deny all;
        }

        proxy_pass https://apis3.xakki.ru;

        # Host обязательно — иначе MinIO не сматчит маршрут к bucket'у.
        proxy_set_header Host apis3.xakki.ru;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Range — глобально http_params затирает заголовок; возвращаем для S3-апстрима.
        proxy_set_header Range $http_range;

        # SNI к апстриму.
        proxy_ssl_server_name on;
        proxy_ssl_verify off;  # стартуем с off; включить on после проверки CA-store

        # Кеш — pcache zone (params/cache_params, подключена через nginx.conf).
        proxy_cache pcache;
        proxy_cache_valid 200 24h;
        proxy_cache_valid 404 1m;
        proxy_cache_lock on;
        proxy_cache_key "$scheme$host$request_uri";
        add_header X-Cache-Status $upstream_cache_status always;

        # Длинный публичный кеш для клиентов (объекты неизменяемы по ключу).
        add_header Cache-Control "public, max-age=86400" always;
    }