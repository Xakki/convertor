# AI worker environment — copy to .env.worker-ai and fill in secrets.
# Usage: docker compose -f docker-compose.worker-ai.yml --env-file .env.worker-ai up -d
#
# Local inference only — no external-API providers (OpenAI/Gemini/Claude removed).

# Locally built working image tag (produced by `make build-ai-cuda` or `make build-ai-cpu`).
# Only ai-base is published to Harbor; working images are built locally on the GPU host.
# GPU (CUDA):  change to DOCKER_IMAGE_AI=xakki-convertor/worker-ai:cuda
DOCKER_IMAGE_AI=xakki-convertor/worker-ai:cpu

# Pull-API endpoint (required).
# Must be the application root — scheme+host only, NO /api path suffix.
# e.g. https://convertor.xakki.pro  (NOT https://convertor.xakki.pro/api)
API_BASE_URL=https://convertor.xakki.pro

# Bearer token workers use for WS-upgrade + direct HTTP to Symfony (set in .env.local server-side)
WORKER_API_TOKEN=

# Worker type (leave as "ai" unless you know what you're doing)
WORKER_TYPE=ai

# --- WS-транспорт (s1-08): воркер — WS-клиент gateway (заменяет poll-API выше) ---
# WORKER_ID — СТАБИЛЬНОЕ имя consumer'а без PID, уникально на экземпляр (мульти-тип — на тип).
WORKER_ID=worker-ai-1
# GATEWAY_WS_URL — публичный WS-эндпоинт gateway (wss://…/ws/worker/).
GATEWAY_WS_URL=wss://convertor.xakki.pro/ws/worker/
# Каденс progress-фреймов (сек) пока задача в работе.
WS_PROGRESS_INTERVAL_S=1
# Число параллельных задач (кредитов); S1 = 1.
WS_SLOTS=1
# Куда качать вход временным файлом (пусто → системный tmp).
WORK_DIR=
# Порог inline-результата (байты); ОБЯЗАН совпадать с порогом gateway (WS_RESULT_INLINE_MAX).
WS_RESULT_INLINE_MAX=262144
# Liveness/backoff (окно reconnect ≪ idle-порога reclaim gateway).
WS_PING_INTERVAL_S=20
WS_LIVENESS_MISSED_PINGS=3
WS_RECONNECT_BACKOFF_BASE_S=1
WS_RECONNECT_BACKOFF_MAX_S=30
WS_RECONNECT_BACKOFF_FACTOR=2

# --- STT: faster-whisper (local) ---
# Whisper model (tiny/base/small/medium/large)
WHISPER_MODEL=base
# Device: "cpu" (default, works everywhere) or "cuda" (GPU, requires nvidia-container-toolkit)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# For CUDA / GPU:
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16

# --- Streaming STT window ---
STREAM_WINDOW_SEC=20
STREAM_OVERLAP_SEC=2

# --- TTS: local engine "espeak" (default) or "pyttsx3" ---
TTS_ENGINE=espeak

# --- Embedding: sentence-transformers (local) ---
EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE defaults to WHISPER_DEVICE when unset
# EMBEDDING_DEVICE=cpu

# --- LLM text→text: local only (NO hosted API) ---
# Backend: "ollama" (default, external self-hosted HTTP) or "llamacpp" (embedded GGUF)
LLM_BACKEND=ollama
# Ollama server URL + model (models swap without rebuilding the image).
# In a Docker container, use host.docker.internal to reach Ollama on the host:
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
# llama.cpp: path to GGUF weights (required only when LLM_BACKEND=llamacpp; mount via volume)
LLM_MODEL_PATH=
# Inference params (apply to both backends)
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
# Optional system prompt (leave empty for none)
LLM_SYSTEM_PROMPT=
