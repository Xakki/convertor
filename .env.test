## Тест-стенд — ОТДЕЛЬНЫЙ compose-проект (свои контейнеры, тома, порты, БД).
##
## Накладывается поверх .env + .env.local при `make test*` (Makefile инклудит этот
## файл при TEST=1), поэтому перетирает в том числе .env.local. Здесь только ДИФФ
## к .env — образы, S3-креды и тюнинг наследуются.
##
## S3 НЕ мокается: e2e нужен живой round-trip. Тест-объекты изолированы key-префиксом
## S3_PREFIX и удаляются самим тестом.
APP_ENV=test
COMPOSE_PROJECT_NAME=xakki-convertor-test
# server — серверная часть, test — сервисы, нужные только тестам (mailpit и пр.).
# `monitoring`/`ai` НЕ активны: metrics-exporter имеет жёсткое имя контейнера
# (конфликт с dev), а тяжёлый worker-ai тестам не нужен.
COMPOSE_PROFILES=server,test

EXT_NGINX_PORT=172.17.0.1:11090
EXT_NGINX_PORTS=127.0.0.1:11091
EXT_MYSQL_PORT=127.0.0.1:11092
EXT_REDIS_PORT=127.0.0.1:11093

# Тест-БД создаёт штатный entrypoint mariadb. Имя/юзер/пароль ОБЯЗАНЫ совпадать
# с DATABASE_URL в app-symfony/.env.test (там они захардкожены).
MARIADB_DATABASE=convertor-test
MARIADB_USER=convertor-test
MARIADB_PASSWORD=123456
MARIADB_ROOT_PASSWORD=123456

# Индекс KeyDB для очередей: должен совпадать с REDIS_DSN / REDIS_SESSIONS_DSN
# в app-symfony/.env.test.
REDIS_QUEUE_DB=3

S3_PREFIX=test_

# Внутри стенда воркеры и PHP ходят по docker-сети, не через публичный URL.
GATEWAY_WS_URL=ws://ws-gateway:8091/ws/worker/
API_BASE_URL=http://nginx
# Тест-значения (не секреты): gateway + воркеры + PHP должны совпадать.
WORKER_API_TOKEN=test-worker-token
GATEWAY_INTERNAL_TOKEN=test-internal-token
