# E2E test env for the `make test-e2e` path — mirrors proxy-service/.env.test.
# Only diffs vs .env; everything else (S3/KeyDB creds, image tags, tuning) is
# inherited from .env / .env.local.
#
# NOTE: unlike proxy-service, S3 secrets are NOT shadowed here — the e2e round-trip
# needs LIVE S3. Test objects are isolated by the `e2e/` key prefix in the inputs
# bucket and deleted by the test itself; result objects are deleted on teardown too.
APP_ENV=test

# Adds the e2e overlay (injects S3_PREFIX into the workers). COMPOSE_FILE is
# `unexport`ed in the Makefile so this value wins on the `--env-file .env.test`
# path; plain `docker compose` still reads COMPOSE_FILE from the auto-loaded .env.
COMPOSE_FILE=docker-compose.yml:docker/fluent-logging.yml:docker/limits.yml:docker/docker-compose.e2e.yml

# Isolate ALL test objects in S3 under their own key prefix (mirrors proxy-service):
# the worker prefixes its generated output keys (stream_consumer.S3_PREFIX) and the
# e2e test prefixes the input objects it uploads.
S3_PREFIX=test_

# KeyDB test isolation: index 3 keeps test streams/keys separate from prod (index 2).
# REDIS_DB must NOT appear in the main .env (it exports and shadows this override).
REDIS_DB=3
REDIS_QUEUE_DB=3

# Workers connect to gateway on the internal docker network.
GATEWAY_WS_URL=ws://ws-gateway:8091/ws/worker/

# Auth tokens for WS-transport (test values — NOT secrets, gateway+workers+PHP must match).
WORKER_API_TOKEN=test-worker-token
GATEWAY_INTERNAL_TOKEN=test-internal-token
# Internal docker URL for worker→PHP input fetch; overrides .env.local's public URL.
API_BASE_URL=http://nginx
# Test DB password — mirrored in root Makefile as DB_TEST_PASS for the pytest runner.
DB_TEST_PASS=123456
